# Minimal additive fragment for OnePlus 13 (dodge) / SM8750.
# Applied on top of arch/arm64/configs/defconfig with:
#   scripts/kconfig/merge_config.sh -m arch/arm64/configs/defconfig \
#     arch/arm64/configs/sm8750.config
# Only options this board needs beyond defconfig. No =n lines.

# SoC pinctrl (not in defconfig)
CONFIG_PINCTRL_SM8750=y

# Display panel + touch
CONFIG_DRM_PANEL_ONEPLUS_DODGE=m
CONFIG_TOUCHSCREEN_SYNA_TCM2=m

# Speaker amplifiers (bring-up driver; no default in Kconfig)
CONFIG_SND_SOC_AW882308=m

# Fuel gauge I2C front-end used by the dodge DT
CONFIG_BATTERY_BQ27XXX_I2C=y

# Early-boot builtins needed before modules can load: UFS root, USB
# gadget (configfs), and the splash simple-framebuffer. DRM=y so
# SIMPLEDRM and the QMP combo PHY can be built-in (both depend on DRM).
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_USB_CONFIGFS=y
CONFIG_TYPEC=y
CONFIG_SM_TCSRCC_8750=y

# GPU/display providers that must be present before deferred_probe_timeout.
# SM_GPUCC_8750 also builds gxclkctl-kaanapali (same Makefile). The Adreno
# SMMU and GPU clock and power from GPUCC; without it built in they time
# out before modules load, msm bind fails, and the panel never attaches.
# DISPCC stays =m (loaded with the display stack).
CONFIG_SM_GPUCC_8750=y
