		cmu_hsi0: clock-controller@11000000 {
			compatible = "google,zumapro-cmu-hsi0";
			reg = <0x0 0x11000000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>, <&cmu_top CLK_DOUT_HSI0_NOC>,
				 <&cmu_top CLK_DOUT_HSI0_PERI>,
				 <&hsi0_alt>, <&hsi0_tcxo>;
			clock-names = "oscclk", "bus", "peri", "alt", "tcxo";
			status = "disabled";
		};

		sysreg_hsi0: syscon@11020000 {
			compatible = "google,zumapro-hsi0-sysreg", "syscon";
			reg = <0x0 0x11020000 0x10000>;
			clocks = <&cmu_hsi0 CLK_GOUT_HSI0_SYSREG>;
			status = "disabled";
		};

		usbdrd_phy: phy@11100000 {
			compatible = "google,zumapro-usb32drd-phy",
				     "google,zuma-usb32drd-phy";
			reg = <0x0 0x11100000 0x200>;
			#phy-cells = <1>;
			clocks = <&cmu_hsi0 CLK_GOUT_HSI0_USB_SUBCTL>;
			clock-names = "phy";
			phys = <&usb_hsphy>;
			phy-names = "hs";
			samsung,pmu-syscon = <&pmu_system_controller>;
			status = "disabled";
		};

		usb_hsphy: phy@11110000 {
			compatible = "google,zumapro-eusb2-phy",
				     "samsung,exynos2200-eusb2-phy";
			reg = <0x0 0x11110000 0x200>;
			#phy-cells = <0>;
			clocks = <&cmu_hsi0 CLK_GOUT_HSI0_EUSB_REF>,
				 <&cmu_hsi0 CLK_GOUT_HSI0_EUSB_BUS>,
				 <&cmu_hsi0 CLK_GOUT_HSI0_EUSB_CTRL>;
			clock-names = "ref", "bus", "ctrl";
			status = "disabled";
		};

		usi2_hsi0: usi@111d00c0 {
			compatible = "google,zumapro-usi", "samsung,exynos850-usi";
			reg = <0x0 0x111d00c0 0x20>;
			clocks = <&cmu_hsi0 CLK_GOUT_HSI0_USI2_PCLK>,
				 <&cmu_hsi0 CLK_GOUT_HSI0_USI2_IP>;
			clock-names = "pclk", "ipclk";
			samsung,sysreg = <&sysreg_hsi0 0x101c>;
			samsung,mode = <USI_MODE_SPI>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x111d0000 0x0 0x111d0000 0x1000>;
			status = "disabled";

			spi20: spi@111d0000 {
				compatible = "google,zumapro-spi", "google,gs101-spi";
				/* USI control starts at 0xc0; do not claim it twice. */
				reg = <0x111d0000 0xc0>;
				interrupts = <GIC_SPI 408 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&cmu_hsi0 CLK_GOUT_HSI0_USI2_PCLK>,
					 <&cmu_hsi0 CLK_GOUT_HSI0_USI2_IP>;
				clock-names = "spi", "spi_busclk0";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		usi3_hsi0: usi@111e00c0 {
			compatible = "google,zumapro-usi", "samsung,exynos850-usi";
			reg = <0x0 0x111e00c0 0x20>;
			clocks = <&cmu_hsi0 CLK_GOUT_HSI0_USI3_PCLK>,
				 <&cmu_hsi0 CLK_GOUT_HSI0_USI3_IP>;
			clock-names = "pclk", "ipclk";
