				#gpio-cells = <2>;
			};
		};

		cmu_hsi2: clock-controller@13000000 {
			compatible = "google,zumapro-cmu-hsi2";
			reg = <0x0 0x13000000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>, <&cmu_top CLK_DOUT_HSI2_NOC>,
				 <&cmu_top CLK_DOUT_HSI2_UFS>,
				 <&cmu_top CLK_DOUT_HSI2_PCIE>;
			clock-names = "oscclk", "bus", "ufs", "pcie";
			status = "disabled";
