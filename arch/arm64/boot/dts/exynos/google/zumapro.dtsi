				compatible = "google,zumapro-spi", "google,gs101-spi";
				/* USI control starts at 0xc0; do not claim it twice. */
				reg = <0x111e0000 0xc0>;
				interrupts = <GIC_SPI 409 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&cmu_hsi0 CLK_GOUT_HSI0_USI3_PCLK>,
					 <&cmu_hsi0 CLK_GOUT_HSI0_USI3_IP>;
				clock-names = "spi", "spi_busclk0";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
