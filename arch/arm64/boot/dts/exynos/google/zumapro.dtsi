		usb: usb@11210000 {
			compatible = "snps,dwc3";
			reg = <0x0 0x11210000 0x10000>;
			interrupts = <GIC_SPI 402 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cmu_hsi0 CLK_GOUT_HSI0_USB_LINK>,
				 <&cmu_hsi0 CLK_MOUT_HSI0_USB20_REF>,
				 <&cmu_hsi0 CLK_GOUT_HSI0_USB_SUSPEND>;
			clock-names = "bus_early", "ref", "suspend";
			phys = <&usbdrd_phy 0>;
			phy-names = "usb2-phy";
			status = "disabled";
		};

		/* The bootloader leaves HSI1 powered; there's no power domain yet. */
		cmu_hsi1: clock-controller@12000000 {
			compatible = "google,zumapro-cmu-hsi1";
			reg = <0x0 0x12000000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>, <&cmu_top CLK_DOUT_HSI1_NOC>,
				 <&hsi1_alt>;
			clock-names = "oscclk", "bus", "alt";
			status = "disabled";
		};

		pinctrl_hsi1: pinctrl@12040000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x0 0x12040000 0x1000>;
			clocks = <&cmu_hsi1 CLK_GOUT_GPIO_HSI1>;
			clock-names = "pclk";
			status = "disabled";

			gph0: gph0-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gph1: gph1-gpio-bank {
