#include <dt-bindings/clock/google,zumapro.h>
#include <dt-bindings/clock/google,zumapro-acpm.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>

/ {
	compatible = "google,zumapro";
	#address-cells = <2>;
	#size-cells = <1>;
	interrupt-parent = <&gic>;

	aliases {
		pinctrl0 = &pinctrl_alive;
		pinctrl1 = &pinctrl_custom_alive;
		pinctrl2 = &pinctrl_far_alive;
		pinctrl8 = &pinctrl_hsi1;
		pinctrl9 = &pinctrl_hsi2;
		pinctrl10 = &pinctrl_hsi2ufs;
		pinctrl11 = &pinctrl_peric0;
		pinctrl12 = &pinctrl_peric1;
	};

	/* ABL applies its debug-policy overlay to these nodes. */
	ect { };

	dpm: dpm { };

	/*
	 * Targets of ABL's debug-policy overlay. Keep these driverless and
	 * separate from reserved-memory: disabling a log consumer must not
	 * release its firmware-owned memory to the allocator.
	 */
	dpm-stubs {
		itmon: itmon {
			status = "disabled";
		};

		log_arrdumppanic: log-array-panic {
			status = "disabled";
		};

		log_bcm: log-bcm {
			status = "disabled";
		};

		log_preslcdump: log-preslcdump {
			status = "disabled";
		};

		log_slcdump: log-slcdump {
			status = "disabled";
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};

				core4 {
					cpu = <&cpu4>;
				};

				core5 {
					cpu = <&cpu5>;
				};

				core6 {
					cpu = <&cpu6>;
				};

				core7 {
					cpu = <&cpu7>;
				};
			};
		};

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x000>;
			enable-method = "psci";
			capacity-dmips-mhz = <193>;
			dynamic-power-coefficient = <70>;
			#cooling-cells = <2>;
			clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CPUCL0>;
			operating-points-v2 = <&cpucl0_opp>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <193>;
			dynamic-power-coefficient = <70>;
			#cooling-cells = <2>;
			clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CPUCL0>;
			operating-points-v2 = <&cpucl0_opp>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x200>;
			enable-method = "psci";
			capacity-dmips-mhz = <193>;
			dynamic-power-coefficient = <70>;
			#cooling-cells = <2>;
			clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CPUCL0>;
			operating-points-v2 = <&cpucl0_opp>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x300>;
			enable-method = "psci";
			capacity-dmips-mhz = <193>;
			dynamic-power-coefficient = <70>;
			#cooling-cells = <2>;
			clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CPUCL0>;
			operating-points-v2 = <&cpucl0_opp>;
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x400>;
			enable-method = "psci";
			capacity-dmips-mhz = <927>;
			dynamic-power-coefficient = <513>;
			#cooling-cells = <2>;
			clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CPUCL1>;
			operating-points-v2 = <&cpucl1_opp>;
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x500>;
			enable-method = "psci";
			capacity-dmips-mhz = <927>;
			dynamic-power-coefficient = <513>;
			#cooling-cells = <2>;
			clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CPUCL1>;
			operating-points-v2 = <&cpucl1_opp>;
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x600>;
			enable-method = "psci";
			capacity-dmips-mhz = <927>;
			dynamic-power-coefficient = <513>;
			#cooling-cells = <2>;
			clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CPUCL1>;
			operating-points-v2 = <&cpucl1_opp>;
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-x4";
			reg = <0x700>;
			enable-method = "psci";
			capacity-dmips-mhz = <1024>;
			dynamic-power-coefficient = <757>;
			#cooling-cells = <2>;
			clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CPUCL2>;
			operating-points-v2 = <&cpucl2_opp>;
		};
	};

	oscclk: clock-oscclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24576000>;
		clock-output-names = "oscclk";
	};

	/* The GPL PHY calibration uses a 38.4 MHz reference configuration. */
	ufs_ref_clk: clock-ufs-ref {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <38400000>;
		clock-output-names = "ufs-ref";
	};

	/* The CAL's nominal rates for HSI0's two board inputs. */
	hsi0_alt: clock-hsi0-alt {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <213000000>;
		clock-output-names = "hsi0-alt";
	};

	hsi0_tcxo: clock-hsi0-tcxo {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "hsi0-tcxo";
	};

	/* The CAL's nominal I_CLK_HSI1_ALT rate. */
	hsi1_alt: clock-hsi1-alt {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <400000000>;
		clock-output-names = "hsi1-alt";
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
	};

	firmware {
		acpm_ipc: power-management {
			compatible = "google,zumapro-acpm-ipc";
			#clock-cells = <1>;
			mboxes = <&ap2apm_mailbox>;
			shmem = <&apm_sram>;
			status = "disabled";

			acpm_tmu: thermal-sensor {
				compatible = "google,zumapro-acpm-tmu";
				#thermal-sensor-cells = <1>;
			};
		};
	};

	/*
	 * CPU levels: the APM firmware's own DVFS levels, read on the Pixel 9a
	 * (the little cluster's 324 and 610 MHz are below stock's 820 MHz
	 * floor), up to the 9a's thermal headroom: the levels above each table's
	 * top, listed in it, are left out for that board. A board with more
	 * headroom can add them. The little cluster stops at 1950 MHz, Google's
	 * max-freq for it.
	 */
	cpucl0_opp: opp-table-cpucl0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-324000000 {
			opp-hz = /bits/ 64 <324000000>;
		};

		opp-610000000 {
			opp-hz = /bits/ 64 <610000000>;
		};

		opp-820000000 {
			opp-hz = /bits/ 64 <820000000>;
		};

		opp-955000000 {
			opp-hz = /bits/ 64 <955000000>;
		};

		opp-1098000000 {
			opp-hz = /bits/ 64 <1098000000>;
		};

		opp-1197000000 {
			opp-hz = /bits/ 64 <1197000000>;
		};

		opp-1328000000 {
			opp-hz = /bits/ 64 <1328000000>;
		};

		opp-1425000000 {
			opp-hz = /bits/ 64 <1425000000>;
		};

		opp-1548000000 {
			opp-hz = /bits/ 64 <1548000000>;
		};

		opp-1696000000 {
			opp-hz = /bits/ 64 <1696000000>;
		};

		opp-1849000000 {
			opp-hz = /bits/ 64 <1849000000>;
		};

		opp-1950000000 {
			opp-hz = /bits/ 64 <1950000000>;
		};

	};

	cpucl1_opp: opp-table-cpucl1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-357000000 {
			opp-hz = /bits/ 64 <357000000>;
		};

		opp-578000000 {
			opp-hz = /bits/ 64 <578000000>;
		};

		opp-648000000 {
			opp-hz = /bits/ 64 <648000000>;
		};

		opp-787000000 {
			opp-hz = /bits/ 64 <787000000>;
		};

		opp-910000000 {
			opp-hz = /bits/ 64 <910000000>;
		};

		opp-1065000000 {
			opp-hz = /bits/ 64 <1065000000>;
		};

		opp-1221000000 {
			opp-hz = /bits/ 64 <1221000000>;
		};

		opp-1328000000 {
			opp-hz = /bits/ 64 <1328000000>;
		};

		opp-1418000000 {
			opp-hz = /bits/ 64 <1418000000>;
		};

		opp-1549000000 {
			opp-hz = /bits/ 64 <1549000000>;
		};

		opp-1795000000 {
			opp-hz = /bits/ 64 <1795000000>;
		};

		opp-1945000000 {
			opp-hz = /bits/ 64 <1945000000>;
		};

		opp-2130000000 {
			opp-hz = /bits/ 64 <2130000000>;
		};

		opp-2245000000 {
			opp-hz = /bits/ 64 <2245000000>;
		};

		opp-2367000000 {
			opp-hz = /bits/ 64 <2367000000>;
		};

		/* 2450 and 2600 MHz stay off: above the cluster's thermal headroom. */
	};

	cpucl2_opp: opp-table-cpucl2 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
		};

		opp-1164000000 {
			opp-hz = /bits/ 64 <1164000000>;
		};

		opp-1396000000 {
			opp-hz = /bits/ 64 <1396000000>;
		};

		opp-1557000000 {
			opp-hz = /bits/ 64 <1557000000>;
		};

		opp-1745000000 {
			opp-hz = /bits/ 64 <1745000000>;
		};

		opp-1885000000 {
			opp-hz = /bits/ 64 <1885000000>;
		};

		opp-1999000000 {
			opp-hz = /bits/ 64 <1999000000>;
		};

		opp-2147000000 {
			opp-hz = /bits/ 64 <2147000000>;
		};

		opp-2294000000 {
			opp-hz = /bits/ 64 <2294000000>;
		};

		opp-2363000000 {
			opp-hz = /bits/ 64 <2363000000>;
		};

		opp-2499000000 {
			opp-hz = /bits/ 64 <2499000000>;
		};

		opp-2687000000 {
			opp-hz = /bits/ 64 <2687000000>;
		};

		/*
		 * 2802, 2914, 2943, 2970, 3015 and 3105 MHz stay off: above the
		 * cluster's thermal headroom.
		 */
	};

	thermal-zones {
		big-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <&acpm_tmu 0>;

			trips {
				big_alert: big-alert {
					temperature = <80000>;
					hysteresis = <5000>;
					type = "passive";
				};

				big_hot: big-hot {
					temperature = <95000>;
					hysteresis = <10000>;
					type = "passive";
				};

				big_crit: big-crit {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&big_alert>;
					cooling-device = <&cpu7 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <&big_hot>;
					cooling-device = <&cpu7 11 0xffffffff>;
				};
			};
		};

		mid-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <&acpm_tmu 1>;

			trips {
				mid_alert: mid-alert {
					temperature = <80000>;
					hysteresis = <5000>;
					type = "passive";
				};

				mid_hot: mid-hot {
					temperature = <95000>;
					hysteresis = <10000>;
					type = "passive";
				};

				mid_crit: mid-crit {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&mid_alert>;
					cooling-device = <&cpu4 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <&mid_hot>;
					cooling-device = <&cpu4 14 0xffffffff>;
				};
			};
		};

		little-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <&acpm_tmu 2>;

			trips {
				little_alert: little-alert {
					temperature = <80000>;
					hysteresis = <5000>;
					type = "passive";
				};

				little_hot: little-hot {
					temperature = <95000>;
					hysteresis = <10000>;
					type = "passive";
				};

				little_crit: little-crit {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&little_alert>;
					cooling-device = <&cpu0 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <&little_hot>;
					cooling-device = <&cpu0 11 0xffffffff>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <2000>;
			thermal-sensors = <&acpm_tmu 3>;

			trips {
				gpu_alert: gpu-alert {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "passive";
				};

				gpu_crit: gpu-crit {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			/* panthor's devfreq cooling: step_wise walks the GPU down its OPPs. */
			cooling-maps {
				map0 {
					trip = <&gpu_alert>;
					cooling-device = <&gpu 0xffffffff 0xffffffff>;
				};
			};
		};
	};

	soc: soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		cmu_misc: clock-controller@10010000 {
			compatible = "google,zumapro-cmu-misc";
			reg = <0x0 0x10010000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>, <&cmu_top CLK_DOUT_MISC_NOC>;
			clock-names = "oscclk", "bus";
			status = "disabled";
		};

		watchdog_cl0: watchdog@10060000 {
			compatible = "google,zumapro-wdt", "google,zuma-wdt";
			reg = <0x0 0x10060000 0x100>;
			interrupts = <GIC_SPI 767 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cmu_misc CLK_GOUT_WDT_CLUSTER0>, <&oscclk>;
			clock-names = "watchdog", "watchdog_src";
			timeout-sec = <30>;
			samsung,syscon-phandle = <&pmu_system_controller>;
			samsung,cluster-index = <0>;
			status = "disabled";
		};

		watchdog_cl1: watchdog@10070000 {
			compatible = "google,zumapro-wdt", "google,zuma-wdt";
			reg = <0x0 0x10070000 0x100>;
			interrupts = <GIC_SPI 768 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cmu_misc CLK_GOUT_WDT_CLUSTER1>, <&oscclk>;
			clock-names = "watchdog", "watchdog_src";
			timeout-sec = <30>;
			samsung,syscon-phandle = <&pmu_system_controller>;
			samsung,cluster-index = <1>;
			status = "disabled";
		};

		gic: interrupt-controller@10400000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-controller;
			reg = <0x0 0x10400000 0x10000>,
			      <0x0 0x10440000 0x200000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
		};

		cmu_peric0: clock-controller@10800000 {
			compatible = "google,zumapro-cmu-peric0";
			reg = <0x0 0x10800000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>, <&cmu_top CLK_DOUT_PERIC0_NOC>,
				 <&cmu_top CLK_DOUT_PERIC0_IP>;
			clock-names = "oscclk", "bus", "ip";
			status = "disabled";
		};

		sysreg_peric0: syscon@10821000 {
			compatible = "google,zumapro-peric0-sysreg", "syscon";
			reg = <0x0 0x10821000 0x1000>;
			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_SYSREG>;
			status = "disabled";
		};

		pinctrl_peric0: pinctrl@10840000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x0 0x10840000 0x1000>;
			clocks = <&cmu_peric0 CLK_GOUT_GPIO_PERIC0>;
			clock-names = "pclk";
			status = "disabled";

			gpp0: gpp0-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp1: gpp1-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp2: gpp2-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp3: gpp3-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp4: gpp4-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp5: gpp5-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp6: gpp6-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp7: gpp7-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp8: gpp8-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp9: gpp9-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp10: gpp10-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp11: gpp11-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp12: gpp12-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp13: gpp13-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp14: gpp14-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp15: gpp15-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp17: gpp17-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpp16: gpp16-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};
		};

		usi2: usi@108900c0 {
			compatible = "google,zumapro-usi", "samsung,exynos850-usi";
			reg = <0x0 0x108900c0 0x20>;
			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI2_PCLK>,
				 <&cmu_peric0 CLK_GOUT_PERIC0_USI2_IPCLK>;
			clock-names = "pclk", "ipclk";
			samsung,sysreg = <&sysreg_peric0 0x4>;
			samsung,mode = <USI_MODE_I2C>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x10890000 0x0 0x10890000 0x1000>;
			status = "disabled";

			hsi2c2: i2c@10890000 {
				compatible = "google,zumapro-hsi2c",
					     "samsung,exynosautov9-hsi2c";
				reg = <0x10890000 0xc0>;
				interrupts = <GIC_SPI 643 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI2_IPCLK>,
					 <&cmu_peric0 CLK_GOUT_PERIC0_USI2_PCLK>;
				clock-names = "hsi2c", "hsi2c_pclk";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		usi3: usi@108a00c0 {
			compatible = "google,zumapro-usi", "samsung,exynos850-usi";
			reg = <0x0 0x108a00c0 0x20>;
			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI3_PCLK>,
				 <&cmu_peric0 CLK_GOUT_PERIC0_USI3_IPCLK>;
			clock-names = "pclk", "ipclk";
			samsung,sysreg = <&sysreg_peric0 0x8>;
			samsung,mode = <USI_MODE_I2C>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x108a0000 0x0 0x108a0000 0x1000>;
			status = "disabled";

			hsi2c3: i2c@108a0000 {
				compatible = "google,zumapro-hsi2c",
					     "samsung,exynosautov9-hsi2c";
