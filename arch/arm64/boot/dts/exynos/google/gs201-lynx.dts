// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 7a (lynx) - M1 bring-up board file.
 *
 * USB (NCM + ACM), the cluster watchdogs from gs201.dtsi, a
 * simple-framebuffer on the buffer ABL leaves DPP0 scanning out, UFS and
 * the touchscreen. The panel driver and the GPU stay disabled.
 */

/dts-v1/;

#include "gs201.dtsi"

/ {
	model = "Google Pixel 7a";
	compatible = "google,gs201-lynx", "google,gs201";

	/*
	 * lynx's SoC is the IPOP package (ro.boot.hw.soc.pkg_mode 1). ABL picks
	 * its base DTB on /soc_compatible, not /soc_id: stock's
	 * vendor_kernel_boot carries a0 and b0 (soc_id) and b0_v2-ipop, and the
	 * live tree on this phone is the IPOP one.
	 */
	soc_compatible {
		B0_IPOP {
			description = "B0,IPOP";
			product_id = <0x9855>;
			major = <0x1>;
			minor = <0x0>;
			pkg_mode = <0x1>;
		};
	};

	chosen {
		/* ABL requires bootargs to exist; it appends its own after these. */
		bootargs = "console=tty0 fbcon=font:TER16x32 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init omamobile.ufs-probe";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * ABL leaves DECON0 -> DSIM0 -> panel (sdc-s6e3fc5) running in
		 * command mode with DPP0 scanning 0xfac00000 (RDMA_BASEADDR_Y8,
		 * read on this phone). There is no panel driver, so no panel
		 * phandle; the size comes from this node.
		 */
		framebuffer0: framebuffer@fac00000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
			memory-region = <&cont_splash_mem>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * UFS VCC. Stock drives it from GPIO gpp0-1 (boot-on), as on
	 * cheetah; there is no gs201 GPIO driver yet, so describe it as
	 * always on, as the bootloader leaves it.
	 */
	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * ABL adds sec_dram, sec_pt and pkvm_guest_firmware to this tree
	 * itself. Stock's tui, mfc_fw and famodel are pools the kernel
	 * places at boot (size and alloc-ranges, no fixed address), so
	 * nothing reserves them here. ramoops keeps stock's layout so a log
	 * survives a warm reboot into slot A.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		ramoops@fd3ff000 {
			compatible = "ramoops";
			reg = <0x0 0xfd3ff000 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		/* Inside stock's wifi_region CMA pool, which this tree does not have. */
		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
			no-map;
		};
	};
};

&acpm_ipc {
	/*
	 * Main PMIC, touch rails only. LDO25M is L25M_TSP_DVDD and LDO26M is
	 * L26M_TS_AVDD, with stock's ranges; nothing else on the stock board
	 * consumes them. Unlike on cheetah, the bootloader leaves both off.
	 * The sub-PMIC is not described.
	 */
	pmic-1 {
		compatible = "samsung,s2mpg12-pmic";
		interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>;
		google,vgpio2ap-sysreg = <&sysreg_vgpio2ap>;
		wakeup-source;

		regulators {
			ldo25m: ldo25m {
				regulator-name = "vddio-ts";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			ldo26m: ldo26m {
				regulator-name = "avdd-ts";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};
		};
	};
};

/* Touchscreen: Goodix GT9895 (Berlin) on USI0 SPI, wired as on cheetah */
&spi_0 {
	pinctrl-0 = <&spi0_bus &spi0_miso &spi0_cs_gpio>;
	cs-gpios = <&gpp20 3 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
	status = "okay";

	touchscreen@0 {
		compatible = "goodix,gt9895";
		reg = <0>;
		spi-max-frequency = <10000000>;
		interrupt-parent = <&gpa7>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpp23 2 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&ts_irq &ts_reset>;
		pinctrl-names = "default";
		avdd-supply = <&ldo26m>;
		vddio-supply = <&ldo25m>;
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};

&usbdrd31_phy {
	status = "okay";
};

&usb_dwc3 {
	status = "okay";
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

&usi0 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

/*
 * Bluetooth: the WCN6855 BT core on the APM USI1 UART (ttySAC18 in Google's
 * kernel), as on cheetah. Its power is the qcom,wcn6855-pmu sequencer below:
 * the shared 0.95 V buck on gph2-5 comes up first with its 7 ms ramp, then
 * BT_EN (gpp16-2), then 50 ms. Off is BT_EN low and then the buck, so
 * Bluetooth owns gph2-5 and drops it on power-off until a Wi-Fi node takes
 * the sequencer's wlan target. WLAN_EN (gph2-4) is left out until there is
 * a PCIe node. 3.2 Mbaud garbles every frame on this UART; 3 Mbaud works.
 */
/ {
	lynx_wcn_buck: regulator-wcn-buck {
		compatible = "regulator-fixed";
		regulator-name = "lynx-wcn-0p95-buck";
		regulator-min-microvolt = <950000>;
		regulator-max-microvolt = <950000>;
		gpio = <&gph2 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <7000>;
	};

	/*
	 * Stand-in for the PMIC rails behind the chip's I/O, 1.3 V and 1.9 V
	 * inputs. Stock's device tree names no supply on its cnss2 or btpower
	 * node (only the three GPIOs), so which PMIC regulators feed them is
	 * unknown; they are on at boot and the host never switches them.
	 */
	lynx_wcn_pmic: regulator-wcn-pmic {
		compatible = "regulator-fixed";
		regulator-name = "lynx-wcn-pmic-rails";
		regulator-always-on;
	};

	wcn6855-pmu {
		compatible = "qcom,wcn6855-pmu";
		pinctrl-0 = <&bt_reg_on>;
		pinctrl-names = "default";

		bt-enable-gpios = <&gpp16 2 GPIO_ACTIVE_HIGH>;

		vddaon-supply = <&lynx_wcn_buck>;
		vddpmu-supply = <&lynx_wcn_buck>;
		vddpmumx-supply = <&lynx_wcn_buck>;
		vddpmucx-supply = <&lynx_wcn_buck>;
		vddrfa0p95-supply = <&lynx_wcn_buck>;
		vddio-supply = <&lynx_wcn_pmic>;
		vddrfa1p3-supply = <&lynx_wcn_pmic>;
		vddrfa1p9-supply = <&lynx_wcn_pmic>;
		vddpcie1p3-supply = <&lynx_wcn_pmic>;
		vddpcie1p9-supply = <&lynx_wcn_pmic>;

		regulators {
			vreg_pmu_rfa_cmn_0p8: ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn_0p8";
			};

			vreg_pmu_aon_0p8: ldo1 {
				regulator-name = "vreg_pmu_aon_0p8";
			};

			vreg_pmu_wlcx_0p8: ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
			};

			vreg_pmu_wlmx_0p8: ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p8";
			};

			vreg_pmu_btcmx_0p8: ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p8";
			};

			vreg_pmu_pcie_1p8: ldo5 {
				regulator-name = "vreg_pmu_pcie_1p8";
			};

			vreg_pmu_pcie_0p9: ldo6 {
				regulator-name = "vreg_pmu_pcie_0p9";
			};

			vreg_pmu_rfa_0p8: ldo7 {
				regulator-name = "vreg_pmu_rfa_0p8";
			};

			vreg_pmu_rfa_1p2: ldo8 {
				regulator-name = "vreg_pmu_rfa_1p2";
			};

			vreg_pmu_rfa_1p7: ldo9 {
				regulator-name = "vreg_pmu_rfa_1p7";
			};
		};
	};
};

&cmu_apm {
	status = "okay";
};

/* gph2 (the buck's GPIO) is on HSI2, disabled in gs201.dtsi. */
&pinctrl_hsi2 {
	status = "okay";
};

&pinctrl_peric0 {
	status = "okay";

	bt_reg_on: bt-reg-on-pins {
		samsung,pins = "gpp16-2";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&serial_apm1 {
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn6855-bt";

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn_0p8>;
		vddaon-supply = <&vreg_pmu_aon_0p8>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p8>;
		vddbtcmx-supply = <&vreg_pmu_btcmx_0p8>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p7-supply = <&vreg_pmu_rfa_1p7>;

		/* 3.2 Mbaud garbles every frame on this UART; 1, 2 and 3 Mbaud work. */
		max-speed = <3000000>;
	};
};

&usi_apm1 {
	status = "okay";
};
