				};

				daifmt {
					dai-format = "i2s";
				};
			};

			be_i2s1_tx {
				dai-name = "I2S_1_TX Capture";
				stream-name = "I2S_1_TX Capture";
				id = <0xc0000003>;
				capture;
				no-pcm;
				useops;
				usefixup;

				cpu {
