					};
				};
			};

			fe_hotword_tap_tx {
				dai-name = "audio_hotword_tap";
				stream-name = "audio_hotword_tap";
				id = <0x40000017>;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000017>;
				};

