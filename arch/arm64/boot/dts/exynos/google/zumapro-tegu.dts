				};
			};

			be_i2s1_rx {
				dai-name = "I2S_1_RX Playback";
				stream-name = "I2S_1_RX Playback";
				id = <0x80000002>;
				playback;
				no-pcm;
				useops;
				usefixup;

				cpu {
