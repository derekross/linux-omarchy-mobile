// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 9a (tegu): first-light board file.
 *
 * Bootloader selector values from Google's GPL zumapro device tree.
 * Copyright 2023 Google LLC.
 */

/dts-v1/;

#include <dt-bindings/clock/google,zumapro-acpm.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/usb/pd.h>
#include "../exynos-pinctrl.h"
#include "zumapro.dtsi"
#include "zumapro-reserved-memory.dtsi"

/ {
	model = "Google Pixel 9a";
	compatible = "google,zumapro-tegu", "google,zumapro";

	chosen {
		/*
		 * ABL requires bootargs to exist and appends its own after
		 * these. It also appends console=null, so a panic is silent:
		 * panic=10 resets the phone by itself.
		 * The firmware advertises PSCI SYSTEM_SUSPEND, but Linux has no
		 * Tensor SoC sleep sequence for "deep": suspend to idle only.
		 */
		bootargs = "console=tty0 clk_ignore_unused pd_ignore_unused rdinit=/init panic=10 mem_sleep_default=s2idle";
	};

	/*
	 * ABL picks the base DTB by matching these children against the
	 * SoC's product id, revision and package. The Pixel 9a has an A0 or
	 * A1 IPOP part.
	 */
	soc_compatible {
		A0_IPOP {
			product_id = <0x9875>;
			major = <0>;
			minor = <0>;
			pkg_mode = <1>;
		};

		A1_IPOP {
			product_id = <0x9875>;
			major = <0>;
			minor = <1>;
			pkg_mode = <1>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			label = "Power";
			linux,code = <KEY_POWER>;
			gpios = <&gpa4 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		key-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa4 1 GPIO_ACTIVE_LOW>;
		};

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa6 2 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * The GPU's levels: the shader rates of the Pixel 9a's GPU DVFS table
	 * up to 890 MHz, each with its paired L2 rate through the ACPM "gpu"
	 * clock; gpu-thermal throttles them from 85 C. 940 MHz, the table's
	 * top, is left out until it has run on the 9a.
	 */
	gpu_opp: opp-table-gpu {
		compatible = "operating-points-v2";

		opp-150000000 {
			opp-hz = /bits/ 64 <150000000>;
		};

		opp-302000000 {
			opp-hz = /bits/ 64 <302000000>;
		};

		opp-337000000 {
			opp-hz = /bits/ 64 <337000000>;
		};

		opp-376000000 {
			opp-hz = /bits/ 64 <376000000>;
		};

		opp-419000000 {
			opp-hz = /bits/ 64 <419000000>;
		};

		opp-467000000 {
			opp-hz = /bits/ 64 <467000000>;
		};

		opp-521000000 {
			opp-hz = /bits/ 64 <521000000>;
		};

		opp-580000000 {
			opp-hz = /bits/ 64 <580000000>;
		};

		opp-649000000 {
			opp-hz = /bits/ 64 <649000000>;
		};

		opp-723000000 {
			opp-hz = /bits/ 64 <723000000>;
		};

		opp-807000000 {
			opp-hz = /bits/ 64 <807000000>;
		};

		opp-850000000 {
			opp-hz = /bits/ 64 <850000000>;
		};

		opp-890000000 {
			opp-hz = /bits/ 64 <890000000>;
		};
	};

	/* UFS VCC, switched by gpp0-1 as on stock. */
	ufs_vcc: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};
};

&{/reserved-memory} {
	abl@f8800000 {
		reg = <0x0 0xf8800000 0x02000000>;
		no-map;
	};

	/* ABL's splash, still scanned out at handover. */
	cont_splash_mem: splash@fac00000 {
		reg = <0x0 0xfac00000 0x009fc900>;
		no-map;
	};

	/* DECON's scanout buffers, below 4 GiB for its 32-bit DMA. */
	display_pool: display-pool {
		compatible = "shared-dma-pool";
		reusable;
		size = <0x04000000>;
		alignment = <0x0 0x00200000>;
		alloc-ranges = <0x0 0x98000000 0x06000000>;
	};
};

&acpm_ipc {
	status = "okay";

	pmic-1 {
		compatible = "samsung,s2mpg14-pmic";

		regulators {
			touch_avdd: ldo4m {
				regulator-name = "touch-avdd";
			};

			eusb_vdd: ldo8m {
				regulator-name = "eusb-vdd";
			};

			eusb_vdda12: ldo9m {
				regulator-name = "eusb-vdda12";
			};

			touch_vdd: ldo25m {
				regulator-name = "touch-vdd";
			};
		};
	};
};

&ap2apm_mailbox {
	status = "okay";
};

&apm_sram {
	status = "okay";
};

&cmu_apm {
	status = "okay";
};

&cmu_g3d {
	status = "okay";
};

&cmu_hsi0 {
	status = "okay";
};

&cmu_hsi1 {
	status = "okay";
};

&cmu_hsi2 {
	status = "okay";
};

&cmu_misc {
	status = "okay";
};

&cmu_peric0 {
	status = "okay";
};

&cmu_peric1 {
	status = "okay";
};

&cmu_top {
	status = "okay";
};

/*
 * DECON0 scans out to DSIM0, so gs-decon can switch the link and the
 * panel between 60 and 120 Hz.
 */
&decon0 {
	memory-region = <&display_pool>, <&cont_splash_mem>;
	memory-region-names = "pool", "boot-framebuffer";
	status = "okay";

	port {
		decon0_out: endpoint {
			remote-endpoint = <&dsi0_in>;
		};
	};
};

&dsi0 {
	status = "okay";

	panel@0 {
		compatible = "google,tg4c";
		reg = <0>;
	};

	port {
		dsi0_in: endpoint {
			remote-endpoint = <&decon0_out>;
		};
	};
};

/*
 * The ST54L's chip enable (gpa0-1) powers the whole chip, NFC and its
 * secure element; stock's eSE driver raises it at probe
 * (ese_chip_enable-gpio in Google's GPL zuma-tegu-ese.dtsi). Nothing here
 * drives the eSE, so hold it high.
 */
&gpa0 {
	nfc-chip-enable-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "nfc-chip-enable";
	};
};

/* The keys' banks and the touchscreen's raise their own interrupts. */
&gpa4 {
	interrupt-controller;
	#interrupt-cells = <2>;
	interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>;
};

&gpa6 {
	interrupt-controller;
	#interrupt-cells = <2>;
	interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 32 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
};

/* The NFC controller's interrupt (gpa7-5). */
&gpa7 {
	interrupt-controller;
	#interrupt-cells = <2>;
	interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
};

/* The USB-C port controller's (gpa8-3) and the MAX77779's (gpa8-0) interrupts. */
&gpa8 {
	interrupt-controller;
	#interrupt-cells = <2>;
	interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH>;
};

&gpn0 {
	interrupt-controller;
	#interrupt-cells = <2>;
	interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>;
};

/*
 * The GPU's core clock is ACPM's paired "gpu" clock, which sets the shader
 * (G3D) and L2 (G3DL2) domains together; coregroup and stacks stay on
 * CMU_G3D's gates.
 */
&gpu {
	clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_GPU>,
		 <&cmu_g3d CLK_GOUT_G3D_COREGROUP>,
		 <&cmu_g3d CLK_GOUT_G3D_STACKS>;
	operating-points-v2 = <&gpu_opp>;
	status = "okay";
};

/* The torch: a TI LM3644 flash driver, both LED outputs on one white LED. */
&hsi2c4 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c4_bus>;
	status = "okay";

	led-controller@63 {
		compatible = "ti,lm3644";
		reg = <0x63>;
		enable-gpios = <&gpp24 1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&torch_enable>;

		led {
			function = LED_FUNCTION_TORCH;
			color = <LED_COLOR_ID_WHITE>;
			led-sources = <1 2>;
			/* A dim flashlight, far below the part's and the LED's limits. */
			led-max-microamp = <75000>;
		};
	};
};

/*
 * The MAX77779's bus: its fuel gauge, its charger and its USB-C port
 * controller. Bring-up, not for merge: the port is dual-role, sourcing VBUS
 * from the charger's chgin-otg regulator over the RT9470's OTG boost (the
 * charger in standby, then the boost, as Google's ext-otg-only use case),
 * and its data role drives dwc3's role switch.
 */
&hsi2c6 {
	clock-frequency = <950000>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c6_bus>;
	status = "okay";

	usb_tcpc: tcpc@25 {
		compatible = "maxim,max77779-tcpc";
		reg = <0x25>;
		interrupt-parent = <&gpa8>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_pd_irq>;
		vbus-supply = <&chgin_otg>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			self-powered;
			op-sink-microwatt = <2600000>;
			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
			/*
			 * 5 V, 900 mA is stock's (zuma/max777x9-tcpc.dtsi: "Extboost
			 * can only do ~1A", set to 900 mA). Stock also sets
			 * PDO_FIXED_SUSPEND and PDO_FIXED_DUAL_ROLE; the 10-28 run
			 * advertised only these two flags, so they stay here as the
			 * record of that run. The mergeable board takes stock's set.
			 */
			source-pdos = <PDO_FIXED(5000, 900, PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;

			port {
				typec_hs: endpoint {
					remote-endpoint = <&usb_hs>;
				};
			};
		};
	};

	charger@69 {
		compatible = "maxim,max77779-charger";
		reg = <0x69>;
		otg-boost-supply = <&otg_boost>;

		chgin_otg: chgin-otg-regulator {
			regulator-name = "chgin-otg";
		};
	};

	fuel_gauge: fuel-gauge@36 {
		compatible = "maxim,max77779-fg";
		reg = <0x36>;
		shunt-resistor-micro-ohms = <2000>;
	};

	/*
	 * The PMIC block: the chip's interrupt line (gpa8-0, stock's
	 * if_pmic_irq) and the SGPIOs that carry the RT9470's lines.
	 */
	max77779_pmic: pmic@66 {
		compatible = "maxim,max77779-pmic";
		reg = <0x66>;
		interrupt-parent = <&gpa8>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&if_pmic_irq>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
	};
};

/* The RT9470, used only as the USB OTG boost (bring-up, not for merge). */
&hsi2c10 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c10_bus>;
	status = "okay";

	otg_boost: regulator@5b {
		compatible = "omamobile,tegu-rt9471-boost";
		reg = <0x5b>;
		regulator-name = "otg-boost";
		/* stock's rt,intr_gpio (PLC_INT_L, pulled up) and rt,ceb_gpio */
		int-gpios = <&max77779_pmic 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		enable-gpios = <&max77779_pmic 7 GPIO_ACTIVE_LOW>;
	};
};

/* The haptics: a CS40L26 on the 9a's LRA, with Google's limits for it. */
&hsi2c9 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c9_bus>;
	status = "okay";

	haptic-driver@43 {
		compatible = "cirrus,cs40l26a";
		reg = <0x43>;
		interrupt-parent = <&gpa6>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gph2 3 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&haptic_reset>;
		cirrus,boost-peak-microamp = <2500000>;
		cirrus,boost-ctl-microvolt = <10000000>;
		cirrus,lra-f0-hz = <162>;
		cirrus,lra-redc-micro-ohms = <14100007>;
		cirrus,vpbr-threshold-microvolt = <3008000>;
	};

	/*
	 * The ST54L NFC controller: plain NCI over I2C, nxp-nci's transport.
	 * Its "enable" line is the chip's RST_N; the PMU's clock pad gives it
	 * its reference clock.
	 */
	nfc@8 {
		compatible = "st,st54l", "nxp,nxp-nci-i2c";
		reg = <0x08>;
		clocks = <&pmu_system_controller 0>;
		interrupt-parent = <&gpa7>;
		interrupts = <5 IRQ_TYPE_LEVEL_HIGH>;
		enable-gpios = <&gph1 6 GPIO_ACTIVE_HIGH>;
	};
};

&pinctrl_alive {
	status = "okay";

	usb_pd_irq: usb-pd-irq-pins {
		samsung,pins = "gpa8-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <0>;
	};

	if_pmic_irq: if-pmic-irq-pins {
		samsung,pins = "gpa8-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <0>;
	};
};

&pinctrl_custom_alive {
	status = "okay";
};

&pinctrl_far_alive {
	status = "okay";
};

&pinctrl_hsi1 {
	status = "okay";

	haptic_reset: haptic-reset-pins {
		samsung,pins = "gph2-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};
};

&pinctrl_hsi2 {
	status = "okay";
};

&pinctrl_hsi2ufs {
	status = "okay";
};

&pinctrl_peric0 {
	status = "okay";

	hsi2c4_bus: hsi2c4-bus-pins {
		samsung,pins = "gpp8-0", "gpp8-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_3>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	hsi2c6_bus: hsi2c6-bus-pins {
		samsung,pins = "gpp12-0", "gpp12-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_3>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	touch_reset_held: touch-reset-held-pins {
		samsung,pins = "gpp1-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-val = <0>;
	};
};

&pinctrl_peric1 {
	status = "okay";

	hsi2c10_bus: hsi2c10-bus-pins {
		samsung,pins = "gpp20-0", "gpp20-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	hsi2c9_bus: hsi2c9-bus-pins {
		samsung,pins = "gpp19-4", "gpp19-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	torch_enable: torch-enable-pins {
		samsung,pins = "gpp24-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};
};

&pmu_system_controller {
	status = "okay";
};

&reboot_mode {
	status = "okay";
};

/* The touchscreen on USI2's dedicated pads: native CS0, SPI mode 0. */
&spi20 {
	status = "okay";

	touchscreen@0 {
		compatible = "syna,s3908";
		reg = <0>;
		interrupt-parent = <&gpn0>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp1 1 GPIO_ACTIVE_LOW>;
		vdd-supply = <&touch_vdd>;
		avdd-supply = <&touch_avdd>;
		spi-max-frequency = <10000000>;
	};
};

&sysreg_apm {
	status = "okay";
};

&sysreg_hsi0 {
	status = "okay";
};

&sysreg_peric0 {
	status = "okay";
};

&sysreg_peric1 {
	status = "okay";
};

&sysreg_ufs {
	status = "okay";
};

/*
 * Behind the init's storage guard (only slot B's boot images and userdata
 * writable), which runs before the disks appear.
 */
&ufs {
	vcc-supply = <&ufs_vcc>;
	status = "okay";
};

&ufs_phy {
	status = "okay";
};

/*
 * USB 2.0 peripheral. The core also holds the sub-control clock, which
 * clocks its link registers: the PHY turns that clock off in suspend, and
 * the core touches those registers before it initialises the PHY again.
 */
&usb {
	clocks = <&cmu_hsi0 CLK_GOUT_HSI0_USB_LINK>,
		 <&cmu_hsi0 CLK_MOUT_HSI0_USB20_REF>,
		 <&cmu_hsi0 CLK_GOUT_HSI0_USB_SUSPEND>,
		 <&cmu_hsi0 CLK_GOUT_HSI0_USB_SUBCTL>;
	clock-names = "bus_early", "ref", "suspend", "subctl";
	dr_mode = "otg";
	maximum-speed = "high-speed";
	snps,dis-u2-freeclk-exists-quirk;
	snps,usb2-gadget-lpm-disable;
	usb-role-switch;
	role-switch-default-mode = "peripheral";
	status = "okay";

	port {
		usb_hs: endpoint {
			remote-endpoint = <&typec_hs>;
		};
	};
};

&usb_hsphy {
	vdd-supply = <&eusb_vdd>;
	vdda12-supply = <&eusb_vdda12>;
	status = "okay";
};

&usbdrd_phy {
	status = "okay";
};

/*
 * Hold the touchscreen in reset before the USI's probe switches it to SPI;
 * the touch driver releases it.
 */
&usi2_hsi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&touch_reset_held>;
	status = "okay";
};

&usi4 {
	status = "okay";
};

&usi6 {
	status = "okay";
};

&usi9 {
	status = "okay";
};

&usi10 {
	status = "okay";
};

&watchdog_cl0 {
	status = "okay";
};

&watchdog_cl1 {
	status = "okay";
};
