			};

			be_i2s0_rx {
				dai-name = "I2S_0_RX Playback";
				stream-name = "I2S_0_RX Playback";
				id = <0x80000000>;
				playback;
				no-pcm;
				useops;
				usefixup;

				cpu {
					sound-dai = <&aud_aoc_path 0x80000000>;
				};

				daifmt {
					dai-format = "i2s";
				};
			};

			be_i2s0_tx {
				dai-name = "I2S_0_TX Capture";
				stream-name = "I2S_0_TX Capture";
				id = <0xc0000001>;
