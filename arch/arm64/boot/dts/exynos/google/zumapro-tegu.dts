// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 9a (tegu): first-light board file.
 *
 * Bootloader selector values from Google's GPL zumapro device tree.
 * Copyright 2023 Google LLC.
 */

/dts-v1/;

#include <dt-bindings/clock/google,zumapro-acpm.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/media/video-interfaces.h>
#include <dt-bindings/usb/pd.h>
#include "../exynos-pinctrl.h"
#include "zumapro.dtsi"
#include "zumapro-reserved-memory.dtsi"

/ {
	model = "Google Pixel 9a";
	compatible = "google,zumapro-tegu", "google,zumapro";

	chosen {
		/*
		 * ABL requires bootargs to exist and appends its own after
		 * these. It also appends console=null, so a panic is silent:
		 * panic=10 resets the phone by itself.
		 * The firmware advertises PSCI SYSTEM_SUSPEND, but Linux has no
		 * Tensor SoC sleep sequence for "deep": suspend to idle only.
		 */
		bootargs = "console=tty0 clk_ignore_unused pd_ignore_unused rdinit=/init panic=10 mem_sleep_default=s2idle";
	};

	/*
	 * ABL picks the base DTB by matching these children against the
	 * SoC's product id, revision and package. The Pixel 9a has an A0 or
	 * A1 IPOP part.
	 */
	soc_compatible {
		A0_IPOP {
			product_id = <0x9875>;
			major = <0>;
			minor = <0>;
			pkg_mode = <1>;
		};

		A1_IPOP {
			product_id = <0x9875>;
			major = <0>;
			minor = <1>;
			pkg_mode = <1>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			label = "Power";
			linux,code = <KEY_POWER>;
			gpios = <&gpa4 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		key-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa4 1 GPIO_ACTIVE_LOW>;
		};

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa6 2 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * The GPU's levels: the shader rates of the Pixel 9a's GPU DVFS table
	 * up to 890 MHz, each with its paired L2 rate through the ACPM "gpu"
	 * clock; gpu-thermal throttles them from 85 C. 940 MHz, the table's
	 * top, is left out until it has run on the 9a.
	 */
	gpu_opp: opp-table-gpu {
		compatible = "operating-points-v2";

		opp-150000000 {
			opp-hz = /bits/ 64 <150000000>;
		};

		opp-302000000 {
			opp-hz = /bits/ 64 <302000000>;
		};

		opp-337000000 {
			opp-hz = /bits/ 64 <337000000>;
		};

		opp-376000000 {
			opp-hz = /bits/ 64 <376000000>;
		};

		opp-419000000 {
			opp-hz = /bits/ 64 <419000000>;
		};

		opp-467000000 {
			opp-hz = /bits/ 64 <467000000>;
		};

		opp-521000000 {
			opp-hz = /bits/ 64 <521000000>;
		};

		opp-580000000 {
			opp-hz = /bits/ 64 <580000000>;
		};

		opp-649000000 {
			opp-hz = /bits/ 64 <649000000>;
		};

		opp-723000000 {
			opp-hz = /bits/ 64 <723000000>;
		};

		opp-807000000 {
			opp-hz = /bits/ 64 <807000000>;
		};

		opp-850000000 {
			opp-hz = /bits/ 64 <850000000>;
		};

		opp-890000000 {
			opp-hz = /bits/ 64 <890000000>;
		};
	};

	/* The cameras' 1.35 V (stock's PP1350_CAM), on the sub-PMIC's GPIO 2. */
	cam_1v35: regulator-cam-1v35 {
		compatible = "regulator-fixed";
		regulator-name = "pp1350-cam";
		regulator-min-microvolt = <1350000>;
		regulator-max-microvolt = <1350000>;
		gpio = <&pmic_sub_gpio 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <2000>;
	};

	/* The main camera's digital supply: a switch on the main PMIC's GPIO 0. */
	cam_main_vdig: regulator-cam-main-vdig {
		compatible = "regulator-fixed";
		regulator-name = "cam-main-vdig";
		gpio = <&pmic_main_gpio 0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* UFS VCC, switched by gpp0-1 as on stock. */
	ufs_vcc: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};
};

&{/reserved-memory} {
	abl@f8800000 {
		reg = <0x0 0xf8800000 0x02000000>;
		no-map;
	};

	/* ABL's splash, still scanned out at handover. */
	cont_splash_mem: splash@fac00000 {
		reg = <0x0 0xfac00000 0x009fc900>;
		no-map;
	};

	/* DECON's scanout buffers, below 4 GiB for its 32-bit DMA. */
	display_pool: display-pool {
		compatible = "shared-dma-pool";
		reusable;
		size = <0x04000000>;
		alignment = <0x0 0x00200000>;
		alloc-ranges = <0x0 0x98000000 0x06000000>;
	};
};

&acpm_ipc {
	status = "okay";

	pmic_main: pmic-1 {
		compatible = "samsung,s2mpg14-pmic";

		pmic_main_gpio: gpio {
			compatible = "samsung,s2mpg14-gpio";
			gpio-controller;
			#gpio-cells = <2>;
		};

		regulators {
			touch_avdd: ldo4m {
				regulator-name = "touch-avdd";
			};

			eusb_vdd: ldo8m {
				regulator-name = "eusb-vdd";
			};

			eusb_vdda12: ldo9m {
				regulator-name = "eusb-vdda12";
			};

			touch_vdd: ldo25m {
				regulator-name = "touch-vdd";
			};
		};
	};

	/*
	 * The sub-PMIC. Its GPIO 0 selects the camera PMIC, GPIO 1 enables
	 * the camera buck-boost and GPIO 2 the cameras' 1.35 V, as in stock's
	 * board description; all ten pins are outputs, low, at hand-off.
	 */
	pmic_sub: pmic-2 {
		compatible = "samsung,s2mpg15-pmic";

		pmic_sub_gpio: gpio {
			compatible = "samsung,s2mpg15-gpio";
			gpio-controller;
			#gpio-cells = <2>;
		};

		regulators {
			/* the camera sensors' shared 1.8 V (stock's S2MPG15 LDO12) */
			cam_1v8: ldo12s {
				regulator-name = "cam-1v8";
			};
		};
	};
};

&ap2apm_mailbox {
	status = "okay";
};

&apm_sram {
	status = "okay";
};

&cmu_apm {
	status = "okay";
};

&cmu_g3d {
	status = "okay";
};

&cmu_hsi0 {
	status = "okay";
};

&cmu_hsi1 {
	status = "okay";
};

&cmu_hsi2 {
	status = "okay";
};

&cmu_misc {
	status = "okay";
};

&cmu_peric0 {
	status = "okay";
};

&cmu_peric1 {
	status = "okay";
};

&cmu_top {
	status = "okay";
};

/* The main camera's receiver: three C-PHY trios on DC-PHY slave 0. */
&csis0 {
	/* without them the link decodes frame starts and nothing else */
	google,lrte-packet-delimiters;
	status = "okay";

	port {
		csis0_in: endpoint {
			remote-endpoint = <&cam_main_out>;
			bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
			data-lanes = <1 2 3>;
		};
	};
};

/* The ultrawide's receiver: four D-PHY lanes on slave 1. */
&csis1 {
	status = "okay";

	port {
		csis1_in: endpoint {
			remote-endpoint = <&cam_uw_out>;
			data-lanes = <1 2 3 4>;
		};
	};
};

/* The front camera's receiver. */
&csis6 {
	status = "okay";

	port {
		csis6_in: endpoint {
			remote-endpoint = <&cam_front_out>;
			data-lanes = <1 2 3 4>;
		};
	};
};

/* The receive settings are a data file taken from the owner's own phone. */
&csis_dcphy {
	firmware-name = "omamobile/camera/zumapro-dcphy.bin";
	status = "okay";
};

/*
 * DECON0 scans out to DSIM0, so gs-decon can switch the link and the
 * panel between 60 and 120 Hz.
 */
&decon0 {
	memory-region = <&display_pool>, <&cont_splash_mem>;
	memory-region-names = "pool", "boot-framebuffer";
	status = "okay";

	port {
		decon0_out: endpoint {
			remote-endpoint = <&dsi0_in>;
		};
	};
};

&dsi0 {
	status = "okay";

	panel@0 {
		compatible = "google,tg4c";
		reg = <0>;
	};

	port {
		dsi0_in: endpoint {
			remote-endpoint = <&decon0_out>;
		};
	};
};

/* The keys' banks and the touchscreen's raise their own interrupts. */
&gpa4 {
	interrupt-controller;
	#interrupt-cells = <2>;
	interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>;
};

&gpa6 {
	interrupt-controller;
	#interrupt-cells = <2>;
	interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 32 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
};

/* The USB-C port controller's interrupt (gpa8-3). */
&gpa8 {
	interrupt-controller;
	#interrupt-cells = <2>;
	interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH>;
};

&gpn0 {
	interrupt-controller;
	#interrupt-cells = <2>;
	interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>;
};

/*
 * The GPU's core clock is ACPM's paired "gpu" clock, which sets the shader
 * (G3D) and L2 (G3DL2) domains together; coregroup and stacks stay on
 * CMU_G3D's gates.
 */
&gpu {
	clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_GPU>,
		 <&cmu_g3d CLK_GOUT_G3D_COREGROUP>,
		 <&cmu_g3d CLK_GOUT_G3D_STACKS>;
	operating-points-v2 = <&gpu_opp>;
	status = "okay";
};

/*
 * The ultrawide, a Sony IMX712 (stock's sensor-leshen-uw), powered in stock's
 * order: PP3200_CAM_BB, PP1350, LDO12S, LDO3, LDO6, reset, master clock.
 * Master clock: CMU_TOP CIS_CLK0 from OSCCLK (24.576 MHz; stock asks for
 * 24 MHz), out on gpp3-0.
 */
&hsi2c2 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c2_bus>;
	status = "okay";

	cam_uw: camera@1a {
		compatible = "sony,imx712";
		reg = <0x1a>;
		clocks = <&cmu_top CLK_DOUT_CIS_CLK0>;
		assigned-clocks = <&cmu_top CLK_MOUT_CIS_CLK0>,
				  <&cmu_top CLK_DOUT_CIS_CLK0>;
		assigned-clock-parents = <&oscclk>, <0>;
		assigned-clock-rates = <0>, <24576000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_uw_mclk>;
		/* high runs the sensor */
		reset-gpios = <&gpp4 2 GPIO_ACTIVE_LOW>;
		vbb-supply = <&cam_bb>;
		vbuck-supply = <&cam_1v35>;
		vif-supply = <&cam_1v8>;
		vdig-supply = <&cam_ldo6>;
		vana-supply = <&cam_ldo3>;
		firmware-name = "omamobile/camera/imx712-uw.bin";
		orientation = <1>;	/* back */

		port {
			cam_uw_out: endpoint {
				remote-endpoint = <&csis1_in>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <552960000 479232000>;
			};
		};
	};
};

/*
 * The front camera, a second IMX712 (stock's sensor-leshen), powered in
 * stock's order: PP3200_CAM_BB, PP1350, LDO12S, LDO2, LDO7, reset, master
 * clock (CMU_TOP CIS_CLK1 from OSCCLK, out on gpp5-0). This bus has no
 * external pull-ups; stock turns the internal ones on.
 */
&hsi2c3 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c3_bus>;
	status = "okay";

	cam_front: camera@1a {
		compatible = "sony,imx712";
		reg = <0x1a>;
		clocks = <&cmu_top CLK_DOUT_CIS_CLK1>;
		assigned-clocks = <&cmu_top CLK_MOUT_CIS_CLK1>,
				  <&cmu_top CLK_DOUT_CIS_CLK1>;
		assigned-clock-parents = <&oscclk>, <0>;
		assigned-clock-rates = <0>, <24576000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_front_mclk>;
		/* high runs the sensor */
		reset-gpios = <&gpp6 2 GPIO_ACTIVE_LOW>;
		vbb-supply = <&cam_bb>;
		vbuck-supply = <&cam_1v35>;
		vif-supply = <&cam_1v8>;
		vdig-supply = <&cam_ldo7>;
		vana-supply = <&cam_ldo2>;
		/* the same sensor and modes as the ultrawide */
		firmware-name = "omamobile/camera/imx712-uw.bin";
		orientation = <0>;	/* front */

		port {
			cam_front_out: endpoint {
				remote-endpoint = <&csis6_in>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <552960000 479232000>;
			};
		};
	};
};

/*
 * The torch (a TI LM3644 flash driver, both LED outputs on one white LED)
 * and the cameras' power chips.
 */
&hsi2c4 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c4_bus>;
	status = "okay";

	led-controller@63 {
		compatible = "ti,lm3644";
		reg = <0x63>;
		enable-gpios = <&gpp24 1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&torch_enable>;

		led {
			function = LED_FUNCTION_TORCH;
			color = <LED_COLOR_ID_WHITE>;
			led-sources = <1 2>;
			/* A dim flashlight, far below the part's and the LED's limits. */
			led-max-microamp = <75000>;
		};
	};

	/*
	 * The camera PMIC: an SLG51002 behind the camera buck-boost, whose
	 * LDOs feed the three camera sensors. Voltages as stock's board
	 * description; every LDO stays off until a sensor is powered.
	 */
	cam_pmic: pmic@75 {
		compatible = "dlg,slg51002";
		reg = <0x75>;
		dlg,cs-gpios = <&pmic_sub_gpio 0 GPIO_ACTIVE_HIGH>;
		vin1-2-supply = <&cam_bb>;
		vin3-supply = <&cam_bb>;
		vin4-supply = <&cam_bb>;
		vin5-supply = <&cam_bb>;

		regulators {
			cam_ldo1: ldo1 {
				regulator-name = "cam-ldo1";
				regulator-min-microvolt = <2250000>;
				regulator-max-microvolt = <2250000>;
			};

			cam_ldo2: ldo2 {
				regulator-name = "cam-ldo2";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			cam_ldo3: ldo3 {
				regulator-name = "cam-ldo3";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			cam_ldo4: ldo4 {
				regulator-name = "cam-ldo4";
				regulator-min-microvolt = <2900000>;
				regulator-max-microvolt = <2900000>;
			};

			cam_ldo5: ldo5 {
				regulator-name = "cam-ldo5";
				regulator-min-microvolt = <2900000>;
				regulator-max-microvolt = <2900000>;
			};

			cam_ldo6: ldo6 {
				regulator-name = "cam-ldo6";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
			};

			cam_ldo7: ldo7 {
				regulator-name = "cam-ldo7";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
			};
		};
	};

	/* The camera buck-boost (stock's PP3200_CAM_BB), an RT6160. */
	cam_bb: regulator@77 {
		compatible = "richtek,rt6160";
		reg = <0x77>;
		enable-gpios = <&pmic_sub_gpio 1 GPIO_ACTIVE_HIGH>;
		regulator-name = "pp3200-cam-bb";
		regulator-min-microvolt = <3200000>;
		regulator-max-microvolt = <3200000>;
		regulator-enable-ramp-delay = <2000>;
	};
};

/*
 * The main camera, a Samsung GN8 (stock's sensor-barghest), on three C-PHY
 * trios, powered in stock's order: PP3200_CAM_BB, PP1350, LDO12S, LDO5,
 * LDO4, LDO1, the digital supply, reset, master clock. Master clock:
 * CMU_TOP CIS_CLK3 from OSCCLK (24.576 MHz; stock asks for 26 MHz), out on
 * gpp9-0. Bus pins pulled up internally, as stock.
 */
&hsi2c5 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c5_bus>;
	status = "okay";

	cam_main: camera@56 {
		compatible = "samsung,s5kgn8";
		reg = <0x56>;
		clocks = <&cmu_top CLK_DOUT_CIS_CLK3>;
		assigned-clocks = <&cmu_top CLK_MOUT_CIS_CLK3>,
				  <&cmu_top CLK_DOUT_CIS_CLK3>;
		assigned-clock-parents = <&oscclk>, <0>;
		assigned-clock-rates = <0>, <24576000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_main_mclk>;
		reset-gpios = <&gpp10 2 GPIO_ACTIVE_LOW>;
		vbb-supply = <&cam_bb>;
		vbuck-supply = <&cam_1v35>;
		vio-supply = <&cam_1v8>;
		vaux-supply = <&cam_ldo5>;
		vaux2-supply = <&cam_ldo4>;
		vana-supply = <&cam_ldo1>;
		vdig-supply = <&cam_main_vdig>;
		firmware-name = "omamobile/camera/s5kgn8-main.bin";
		/* its lines burst at over 2 GB/s; 550 MB/s lines land cleanly */
		samsung,max-line-throughput = <500>;
		orientation = <1>;	/* back */

		port {
			cam_main_out: endpoint {
				remote-endpoint = <&csis0_in>;
				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
				data-lanes = <1 2 3>;
				link-frequencies = /bits/ 64 <1370112000>;
			};
		};
	};
};

/*
 * The MAX77779's bus: its USB-C port controller, a sink with no link to the
 * USB controller's role yet, its fuel gauge and its charger.
 */
&hsi2c6 {
	clock-frequency = <950000>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c6_bus>;
	status = "okay";

	usb_tcpc: tcpc@25 {
		compatible = "maxim,max77779-tcpc";
		reg = <0x25>;
		interrupt-parent = <&gpa8>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_pd_irq>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "sink";
			self-powered;
			op-sink-microwatt = <2600000>;
			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
		};
	};

	fuel_gauge: fuel-gauge@36 {
		compatible = "maxim,max77779-fg";
		reg = <0x36>;
		shunt-resistor-micro-ohms = <2000>;
		power-supplies = <&charger>;
	};

	charger: charger@69 {
		compatible = "maxim,max77779-charger";
		reg = <0x69>;
	};
};

/* The haptics: a CS40L26 on the 9a's LRA, with Google's limits for it. */
&hsi2c9 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c9_bus>;
	status = "okay";

	haptic-driver@43 {
		compatible = "cirrus,cs40l26a";
		reg = <0x43>;
		interrupt-parent = <&gpa6>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gph2 3 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&haptic_reset>;
		cirrus,boost-peak-microamp = <2500000>;
		cirrus,boost-ctl-microvolt = <10000000>;
		cirrus,lra-f0-hz = <162>;
		cirrus,lra-redc-micro-ohms = <14100007>;
		cirrus,vpbr-threshold-microvolt = <3008000>;
	};
};

&pinctrl_alive {
	status = "okay";

	usb_pd_irq: usb-pd-irq-pins {
		samsung,pins = "gpa8-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <0>;
	};
};

&pinctrl_custom_alive {
	status = "okay";
};

&pinctrl_far_alive {
	status = "okay";
};

&pinctrl_hsi1 {
	status = "okay";

	haptic_reset: haptic-reset-pins {
		samsung,pins = "gph2-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};
};

&pinctrl_hsi2 {
	status = "okay";
};

&pinctrl_hsi2ufs {
	status = "okay";
};

&pinctrl_peric0 {
	status = "okay";

	cam_front_mclk: cam-front-mclk-pins {
		samsung,pins = "gpp5-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <1>;
	};

	cam_main_mclk: cam-main-mclk-pins {
		samsung,pins = "gpp9-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <1>;
	};

	cam_uw_mclk: cam-uw-mclk-pins {
		samsung,pins = "gpp3-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <1>;
	};

	hsi2c2_bus: hsi2c2-bus-pins {
		samsung,pins = "gpp4-0", "gpp4-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_3>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	hsi2c3_bus: hsi2c3-bus-pins {
		samsung,pins = "gpp6-0", "gpp6-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_3>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <0>;
	};

	hsi2c4_bus: hsi2c4-bus-pins {
		samsung,pins = "gpp8-0", "gpp8-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_3>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	hsi2c5_bus: hsi2c5-bus-pins {
		samsung,pins = "gpp10-0", "gpp10-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_3>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <0>;
	};

	hsi2c6_bus: hsi2c6-bus-pins {
		samsung,pins = "gpp12-0", "gpp12-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_3>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	touch_reset_held: touch-reset-held-pins {
		samsung,pins = "gpp1-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-val = <0>;
	};
};

&pinctrl_peric1 {
	status = "okay";

	hsi2c9_bus: hsi2c9-bus-pins {
		samsung,pins = "gpp19-4", "gpp19-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	torch_enable: torch-enable-pins {
		samsung,pins = "gpp24-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};
};

&pmu_system_controller {
	status = "okay";
};

&reboot_mode {
	status = "okay";
};

/* The touchscreen on USI2's dedicated pads: native CS0, SPI mode 0. */
&spi20 {
	status = "okay";

	touchscreen@0 {
		compatible = "syna,s3908";
		reg = <0>;
		interrupt-parent = <&gpn0>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp1 1 GPIO_ACTIVE_LOW>;
		vdd-supply = <&touch_vdd>;
		avdd-supply = <&touch_avdd>;
		spi-max-frequency = <10000000>;
	};
};

&sysreg_apm {
	status = "okay";
};

&sysreg_hsi0 {
	status = "okay";
};

&sysreg_ispfe {
	status = "okay";
};

&sysreg_peric0 {
	status = "okay";
};

&sysreg_peric1 {
	status = "okay";
};

&sysreg_ufs {
	status = "okay";
};

/*
 * Behind the init's storage guard (only slot B's boot images and userdata
 * writable), which runs before the disks appear.
 */
&ufs {
	vcc-supply = <&ufs_vcc>;
	status = "okay";
};

&ufs_phy {
	status = "okay";
};

/*
 * USB 2.0 peripheral. The core also holds the sub-control clock, which
 * clocks its link registers: the PHY turns that clock off in suspend, and
 * the core touches those registers before it initialises the PHY again.
 */
&usb {
	clocks = <&cmu_hsi0 CLK_GOUT_HSI0_USB_LINK>,
		 <&cmu_hsi0 CLK_MOUT_HSI0_USB20_REF>,
		 <&cmu_hsi0 CLK_GOUT_HSI0_USB_SUSPEND>,
		 <&cmu_hsi0 CLK_GOUT_HSI0_USB_SUBCTL>;
	clock-names = "bus_early", "ref", "suspend", "subctl";
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	snps,dis-u2-freeclk-exists-quirk;
	snps,usb2-gadget-lpm-disable;
	status = "okay";
};

&usb_hsphy {
	vdd-supply = <&eusb_vdd>;
	vdda12-supply = <&eusb_vdda12>;
	status = "okay";
};

&usbdrd_phy {
	status = "okay";
};

&usi2 {
	status = "okay";
};

/*
 * Hold the touchscreen in reset before the USI's probe switches it to SPI;
 * the touch driver releases it.
 */
&usi2_hsi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&touch_reset_held>;
	status = "okay";
};

&usi3 {
	status = "okay";
};

&usi4 {
	status = "okay";
};

&usi5 {
	status = "okay";
};

&usi6 {
	status = "okay";
};

&usi9 {
	status = "okay";
};

&watchdog_cl0 {
	status = "okay";
};

&watchdog_cl1 {
	status = "okay";
};
