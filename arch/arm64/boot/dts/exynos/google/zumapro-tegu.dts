				};
			};

			be_i2s2_rx {
				dai-name = "I2S_2_RX Playback";
				stream-name = "I2S_2_RX Playback";
				id = <0x80000004>;
				playback;
				no-pcm;
				useops;
				usefixup;

				cpu {
					sound-dai = <&aud_aoc_path 0x80000004>;
				};

				daifmt {
					dai-format = "i2s";
