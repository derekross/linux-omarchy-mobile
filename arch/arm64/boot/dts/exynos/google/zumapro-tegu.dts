					};
				};
			};

			fe_voip_rx {
				dai-name = "audio_voip_rx";
				stream-name = "audio_voip_rx";
				id = <0x0a>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x0a>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_voip_ep>;
					};
				};
			};

			fe_voip_tx {
				dai-name = "audio_voip_tx";
				stream-name = "audio_voip_tx";
				id = <0x4000000a>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x4000000a>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_voip_ep>;
					};
				};
			};

			fe_incall_pb0_rx {
				dai-name = "audio_incall_pb_0";
				stream-name = "audio_incall_pb_0";
				id = <0x0b>;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x0b>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_incall_ep>;
					};
				};
			};

			fe_incall_pb1_rx {
				dai-name = "audio_incall_pb_1";
				stream-name = "audio_incall_pb_1";
				id = <0x0c>;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x0c>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_incall_ep>;
					};
				};
			};

			fe_incall_cap0_tx {
				dai-name = "audio_incall_cap_0";
				stream-name = "audio_incall_cap_0";
				id = <0x4000000d>;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x4000000d>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_incall_ep>;
					};
				};
			};

			fe_incall_cap1_tx {
				dai-name = "audio_incall_cap_1";
				stream-name = "audio_incall_cap_1";
				id = <0x4000000e>;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x4000000e>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_incall_ep>;
					};
				};
			};

			fe_incall_cap2_tx {
				dai-name = "audio_incall_cap_2";
				stream-name = "audio_incall_cap_2";
				id = <0x4000000f>;
				capture;

				cpu {
