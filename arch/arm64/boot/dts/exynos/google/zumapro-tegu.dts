// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 9a (tegu): first-light board file.
 *
 * Bootloader selector values from Google's GPL zumapro device tree.
 * Copyright 2023 Google LLC.
 */

/dts-v1/;

#include <dt-bindings/clock/google,zumapro-acpm.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/usb/pd.h>
#include "../exynos-pinctrl.h"
#include "zumapro.dtsi"
#include "zumapro-reserved-memory.dtsi"

/ {
	model = "Google Pixel 9a";
	compatible = "google,zumapro-tegu", "google,zumapro";

	chosen {
		/*
		 * ABL requires bootargs to exist and appends its own after
		 * these. It also appends console=null, so a panic is silent:
		 * panic=10 resets the phone by itself.
		 * The firmware advertises PSCI SYSTEM_SUSPEND, but Linux has no
		 * Tensor SoC sleep sequence for "deep": suspend to idle only.
		 */
		bootargs = "console=tty0 clk_ignore_unused pd_ignore_unused rdinit=/init panic=10 mem_sleep_default=s2idle";
	};

	/*
	 * ABL picks the base DTB by matching these children against the
	 * SoC's product id, revision and package. The Pixel 9a has an A0 or
	 * A1 IPOP part.
	 */
	soc_compatible {
		A0_IPOP {
			product_id = <0x9875>;
			major = <0>;
			minor = <0>;
			pkg_mode = <1>;
		};

		A1_IPOP {
			product_id = <0x9875>;
			major = <0>;
			minor = <1>;
			pkg_mode = <1>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			label = "Power";
			linux,code = <KEY_POWER>;
			gpios = <&gpa4 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		key-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa4 1 GPIO_ACTIVE_LOW>;
		};

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa6 2 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * The GPU's levels: the shader rates of the Pixel 9a's GPU DVFS table
	 * up to 890 MHz, each with its paired L2 rate through the ACPM "gpu"
	 * clock; gpu-thermal throttles them from 85 C. 940 MHz, the table's
	 * top, is left out until it has run on the 9a.
	 */
	gpu_opp: opp-table-gpu {
		compatible = "operating-points-v2";

		opp-150000000 {
			opp-hz = /bits/ 64 <150000000>;
		};

		opp-302000000 {
			opp-hz = /bits/ 64 <302000000>;
		};

		opp-337000000 {
			opp-hz = /bits/ 64 <337000000>;
		};

		opp-376000000 {
			opp-hz = /bits/ 64 <376000000>;
		};

		opp-419000000 {
			opp-hz = /bits/ 64 <419000000>;
		};

		opp-467000000 {
			opp-hz = /bits/ 64 <467000000>;
		};

		opp-521000000 {
			opp-hz = /bits/ 64 <521000000>;
		};

		opp-580000000 {
			opp-hz = /bits/ 64 <580000000>;
		};

		opp-649000000 {
			opp-hz = /bits/ 64 <649000000>;
		};

		opp-723000000 {
			opp-hz = /bits/ 64 <723000000>;
		};

		opp-807000000 {
			opp-hz = /bits/ 64 <807000000>;
		};

		opp-850000000 {
			opp-hz = /bits/ 64 <850000000>;
		};

		opp-890000000 {
			opp-hz = /bits/ 64 <890000000>;
		};
	};

	/* UFS VCC, switched by gpp0-1 as on stock. */
	ufs_vcc: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	/*
	 * The AoC sound card as stock's device tree describes it (Google's
	 * driver, so Google's compatibles): the
	 * entry-point PCMs, voice, compress, path, no-host, VoIP and in-call
	 * nodes and the stock DAI links, with the two TAS2572s on TDM 0. The
	 * haptics codec and the DisplayPort links are left out.
	 */
	aoc_pcm_ep: aoc_pcm_drv {
		compatible = "google-aoc-snd-pcm";
	};

	aoc_voice_ep: aoc_voice_drv {
		compatible = "google-aoc-snd-voice";
	};

	aoc_compr_ep: aoc_compr_drv {
		compatible = "google-aoc-snd-compr";
	};

	aud_aoc_path: aoc_path {
		#sound-dai-cells = <0x01>;
		compatible = "google-aoc-path";
	};

	aoc_nohost_drv: aoc_nohost {
		compatible = "google-aoc-snd-nohost";
	};

	aoc_voip_ep: aoc_voip_drv {
		compatible = "google-aoc-snd-voip";
	};

	aoc_incall_ep: aoc_incall_drv {
		compatible = "google-aoc-snd-incall";
	};

	aoc_snd_card: sound-aoc {
		compatible = "google-aoc-snd-card";
		/*
		 * Not "google,aoc-snd-card": the 7 Pro's UCM profile and
		 * WirePlumber rules match that name.
		 */
		aoc-card-name = "google,tegu-aoc-snd-card";

		codec_cfg {
			top {
				of_node = <&tas2572_top>;
				prefix = "Top";
			};

			bottom {
				of_node = <&tas2572_bottom>;
				prefix = "Bottom";
			};
		};

		dai_link {
			fe_ep1_rx {
				dai-name = "audio_playback0";
				stream-name = "EP1 playback";
				id = <0x00>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x00>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep2_rx {
				dai-name = "audio_playback1";
				stream-name = "EP2 playback";
				id = <0x01>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x01>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep3_rx {
				dai-name = "audio_playback2";
				stream-name = "EP3 playback";
				id = <0x02>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x02>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep4_rx {
				dai-name = "audio_playback3";
				stream-name = "EP4 playback";
				id = <0x03>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x03>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep5_rx {
				dai-name = "audio_playback4";
				stream-name = "EP5 playback";
				id = <0x04>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x04>;
				};

				platform {
					vorx {
						of_drv = <&aoc_voice_ep>;
					};
				};
			};

			fe_ep6_rx {
				dai-name = "audio_playback5";
				stream-name = "EP6 playback";
				id = <0x05>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x05>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep7_rx {
				dai-name = "audio_playback6";
				stream-name = "EP7 playback";
				id = <0x06>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x06>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_compr_ep>;
					};
				};
			};

			fe_ep8_rx {
				dai-name = "audio_haptics";
				stream-name = "EP8 playback";
				id = <0x07>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x07>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep1_tx {
				dai-name = "audio_capture0";
				stream-name = "EP1 capture";
				id = <0x40000000>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000000>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep2_tx {
				dai-name = "audio_capture1";
				stream-name = "EP2 capture";
				id = <0x40000001>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000001>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep3_tx {
				dai-name = "audio_capture2";
				stream-name = "EP3 capture";
				id = <0x40000002>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000002>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep4_tx {
				dai-name = "audio_capture3";
				stream-name = "EP4 capture";
				id = <0x40000003>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000003>;
				};

				platform {
					votx {
						of_drv = <&aoc_voice_ep>;
					};
				};
			};

			fe_ep5_tx {
				dai-name = "ultrasonic_capture";
				stream-name = "EP5 capture";
				id = <0x40000004>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000004>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep6_tx {
				dai-name = "audio_capture5";
				stream-name = "EP6 capture";
				id = <0x40000005>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000005>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_nohost1_rx {
				dai-name = "nohost1 playback";
				stream-name = "nohost1 playback";
				id = <0x20000008>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x20000008>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_nohost_drv>;
