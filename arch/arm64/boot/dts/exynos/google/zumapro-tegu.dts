				};
			};

			be_tdm0_rx {
				dai-name = "TDM_0_RX Playback";
				stream-name = "TDM_0_RX Playback";
				id = <0x80000006>;
				playback;
				no-pcm;
				useops;
				usefixup;

				codec {
					sound-dai = <&tas2572_top>, <&tas2572_bottom>;
				};

				cpu {
					sound-dai = <&aud_aoc_path 0x80000006>;
				};

				daifmt {
					dai-format = "dsp_a";
				};
			};

			be_tdm0_tx {
				dai-name = "TDM_0_TX Capture";
				stream-name = "TDM_0_TX Capture";
				id = <0xc0000007>;
				capture;
				no-pcm;
				useops;
				usefixup;

				codec {
