					};
				};
			};

			fe_incall_pb2_rx {
				dai-name = "audio_incall_pb_2";
				stream-name = "audio_incall_pb_2";
				id = <0x14>;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x14>;
				};

				platform {
