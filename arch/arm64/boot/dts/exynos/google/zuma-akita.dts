// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 8a (akita) - first-light board file.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "zuma.dtsi"

/ {
	model = "Google Pixel 8a";
	compatible = "google,zuma-akita", "google,zuma";

	/*
	 * zuma's ABL picks the base DTB by matching these children against
	 * the SoC's product id, revision and package; there is no /soc_id.
	 * A retail akita has a B0/B1 IPOP part (stock base DTB 3, which
	 * carries exactly these two), where husky's is FOPLP.
	 */
	soc_compatible {
		B0_IPOP {
			product_id = <0x9865>;
			major = <1>;
			minor = <0>;
			pkg_mode = <1>;
		};

		B1_IPOP {
			product_id = <0x9865>;
			major = <1>;
			minor = <1>;
			pkg_mode = <1>;
		};
	};

	/*
	 * UFS VCC, switched by gpp0-1 as on stock, and as on the Pixel 8 Pro.
	 * ABL hands over with it off, so the UFS driver must turn it on.
	 */
	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The pack, for the fuel gauge and the charger cell. 4486 mAh is the
	 * design capacity the stock phone's gauge reports
	 * (charge_full_design); Google's charger node names 4404 mAh. The
	 * charge limits are deliberately below stock's 4.48 V
	 * (google,fv-max-uv): 4.2 V and about 0.3 C, as on the Pixel 8 Pro,
	 * until a review raises them.
	 */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <4486000>;
		voltage-max-design-microvolt = <4480000>;
		voltage-min-design-microvolt = <3300000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		constant-charge-current-max-microamp = <1320000>;
	};

	chosen {
		/*
		 * ABL requires bootargs to exist; it appends its own after these.
		 * reboot=warm: a cold PSCI reset clears the reboot reason in
		 * SYSIP_DAT0 before ABL reads it, so "reboot bootloader" would
		 * only boot the slot again.
		 * The watchdog driver stops the bootloader's watchdogs, so a
		 * hang that never panics lasts until someone resets the phone
		 * with its buttons: panic on soft and hard lockups and on RCU
		 * stalls, so that panic=10 resets the phone by itself.
		 * mem_sleep_default=s2idle: the firmware offers PSCI system
		 * suspend, so "mem" would otherwise mean "deep", which needs a
		 * PMU sleep sequence the kernel doesn't have yet.
		 */
		bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.panic_on_rcu_stall=1 clk_ignore_unused pd_ignore_unused rdinit=/init mem_sleep_default=s2idle";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * ABL's splash, still scanned out at handover: DPP0's
		 * RDMA_BASEADDR_P0 (0x19900040) reads 0xfac00000 on a booted
		 * phone, as on the Pixel 8 Pro. The panel is DSI command mode,
		 * so new frames reach it only once DECON0's trigger is unmasked.
		 */
		framebuffer0: framebuffer {
			compatible = "simple-framebuffer";
			memory-region = <&cont_splash_mem>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
			panel = <&panel0>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa4 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa6 2 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa4 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	/*
	 * Without a panel node simpledrm estimates the display's physical
	 * size from its pixels at 96 dpi: 285x635 mm instead of 64x141 mm,
	 * which sizes everything that works in millimetres (the on-screen
	 * keyboard) wrongly. simpledrm only reads width-mm and height-mm from
	 * this node. It stays disabled so that fw_devlink does not make the
	 * framebuffer wait for a driver this node will never have. 64x141 mm
	 * is the lit area, measured with a ruler on a Pixel 8a, as for a
	 * 6.1-inch 20:9 panel; Google's touch node has panel-height-mm = 141.
	 * Stock's figure is larger than the glass: Google's panel-google-ak3b.c
	 * gives the ak3b 70x149 mm, and the stock phone's DPI follows from it
	 * (xDpi 391.885, yDpi 409.127 for 1080x2400).
	 */
	panel0: panel {
		status = "disabled";
		width-mm = <64>;
		height-mm = <141>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
			no-map;
		};
	};
};

/*
 * The main PMIC, behind the ACPM firmware. Its regulators are described
 * with their consumers, which run them through the firmware. The touch
 * controller's avdd is 3.0 V here (the stock phone's LDO4M), not the
 * Pixel 8 Pro's 3.3 V.
 */
&acpm_ipc {
	pmic-1 {
		compatible = "samsung,s2mpg14-pmic";

		regulators {
			touch_avdd: ldo4m {
				regulator-name = "touch-avdd";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};

			touch_vdd: ldo25m {
				regulator-name = "touch-vdd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};
		};
	};
};

&cmu_peric1 {
	status = "okay";
};

/*
 * The battery pack's EEPROM, as on the Pixel 8 Pro: an at,24c08 at 0x50
 * (Google's zuma-akita-battery.dtsi, pack_bee). Byte 0x17 is the battery
 * ID that picks the fuel gauge's model. Read-only; the bus stays off
 * here and a bring-up overlay switches USI9 and hsi2c_9 on.
 */
&hsi2c_9 {
	clock-frequency = <400000>;

	eeprom@50 {
		compatible = "atmel,24c08";
		reg = <0x50>;
		pagesize = <16>;
		read-only;
	};
};

/*
 * The MAX77759's fuel gauge (0x36) and PMIC (0x66, which also holds the
 * charger at 0x69), as on the Pixel 8 Pro (Google's
 * zuma-akita-battery.dtsi: the same addresses, interrupts gpa7-7 and
 * gpa8-0, and a 5 mOhm sense resistor). The bus pins are pulled up, as
 * the stock phone's live device tree has them. The Type-C controller at
 * 0x25 isn't described yet.
 */
&hsi2c_11 {
	clock-frequency = <400000>;
	status = "okay";

	fuel-gauge@36 {
		compatible = "maxim,max77759-fg";
		reg = <0x36>;
		interrupts-extended = <&gpa7 7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_fg_int>;
		pinctrl-names = "default";
		shunt-resistor-micro-ohms = <5000>;
		monitored-battery = <&battery>;
	};

	pmic@66 {
		compatible = "maxim,max77759";
		reg = <0x66>;
		interrupts-extended = <&gpa8 0 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_int>;
		pinctrl-names = "default";
		interrupt-controller;
		#interrupt-cells = <2>;
		/* for the charger cell */
		monitored-battery = <&battery>;

		gpio {
			compatible = "maxim,max77759-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};

&spi20 {
	status = "okay";

	/*
	 * Goodix GT9895 (Berlin), the Pixel 7a's controller: both of stock's
	 * firmware files (goodix_firmware_ak3a.bin and _ak3b.bin) say "9895".
	 * Wired as zuma-husky's touchscreen: 10 MHz, interrupt on gpn0-0
	 * (falling edge, stock's goodix,irq-flags = 2), reset on gpp21-2.
	 * avdd is LDO4M at 3.0 V and vddio LDO25M at 1.8 V, as on stock.
	 */
	touchscreen@0 {
		compatible = "goodix,gt9895";
		reg = <0>;
		spi-max-frequency = <10000000>;
		interrupt-parent = <&gpn0>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpp21 2 GPIO_ACTIVE_LOW>;
		avdd-supply = <&touch_avdd>;
		vddio-supply = <&touch_vdd>;
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts_irq &ts_reset>;
	};
};

&sysreg_peric1 {
	status = "okay";
};

/*
 * Behind the init's storage guard (only slot B's boot images and userdata
 * writable), which sets every partition read-only before anything mounts
 * them.
 */
&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

&usb_dwc3 {
	status = "okay";
};

&usb_hsphy {
	status = "okay";
};

&usbdrd_phy {
	status = "okay";
};

&usi2_hsi0 {
	status = "okay";
};

&usi11 {
	status = "okay";
};
