// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 8 Pro (husky) - first-light board file.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/usb/pd.h>
#include "zuma.dtsi"

/ {
	model = "Google Pixel 8 Pro";
	compatible = "google,zuma-husky", "google,zuma";

	/*
	 * zuma's ABL picks the base DTB by matching these children against
	 * the SoC's product id, revision and package; there is no /soc_id.
	 * A retail husky has a B0/B1 FOPLP part (stock base DTB 2, which
	 * carries exactly these two).
	 */
	soc_compatible {
		B0_FOPLP {
			product_id = <0x9865>;
			major = <1>;
			minor = <0>;
			pkg_mode = <0>;
		};

		B1_FOPLP {
			product_id = <0x9865>;
			major = <1>;
			minor = <1>;
			pkg_mode = <0>;
		};
	};

	/*
	 * UFS VCC, switched by gpp0-1 as on stock. ABL hands over with it
	 * off, so the UFS driver must turn it on.
	 */
	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * Without a panel node simpledrm estimates the display's physical
	 * size from its pixels at 96 dpi: 355x791 mm instead of 70x155 mm,
	 * which sizes everything that works in millimetres (the on-screen
	 * keyboard is half as tall as it should be) wrongly. simpledrm only
	 * reads width-mm and height-mm from this node. It stays disabled so
	 * that fw_devlink does not make the framebuffer wait for a driver
	 * this node will never have. 70x155 mm is HK3_WIDTH_MM and
	 * HK3_HEIGHT_MM in Google's panel-gs-hk3.c for the Pixel 8 Pro.
	 */
	panel0: panel {
		status = "disabled";
		width-mm = <70>;
		height-mm = <155>;
	};

	chosen {
		/*
		 * ABL requires bootargs to exist; it appends its own after these.
		 * reboot=warm: a cold PSCI reset clears the reboot reason in
		 * SYSIP_DAT0 before ABL reads it, so "reboot bootloader" would
		 * only boot the slot again.
		 * The watchdog driver stops the bootloader's watchdogs, so a
		 * hang that never panics lasts until someone holds Power and
		 * Volume Up: panic on soft and hard lockups and on RCU stalls,
		 * so that panic=10 resets the phone by itself.
		 */
		bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.panic_on_rcu_stall=1 clk_ignore_unused pd_ignore_unused rdinit=/init";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * ABL's splash, still scanned out at handover: DPP0's
		 * RDMA_BASEADDR_P0 (0x19900040) reads 0xfac00000 on a booted
		 * phone, as on the Pixel 7 Pro. The panel is DSI command mode,
		 * so new frames reach it only once DECON0's trigger is unmasked.
		 */
		framebuffer0: framebuffer {
			compatible = "simple-framebuffer";
			panel = <&panel0>;
			memory-region = <&cont_splash_mem>;
			width = <1344>;
			height = <2992>;
			stride = <(1344 * 4)>;
			format = "a8r8g8b8";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa4 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa6 2 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa4 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	/*
	 * The 4950 mAh pack (Google's husky battery data). The charger and
	 * gauge limits are deliberately conservative: stock charges to 4.48 V
	 * in steps (4.20/4.30/4.35/4.48 V by temperature), which is not
	 * described here yet. 0.3 C is 1485 mA.
	 */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <4950000>;
		voltage-max-design-microvolt = <4480000>;
		voltage-min-design-microvolt = <3300000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		constant-charge-current-max-microamp = <1485000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 (1344 * 2992 * 4)>;
			no-map;
		};
	};
};

/*
 * The main PMIC, behind the ACPM firmware. Its regulators are described
 * with their consumers, which run them through the firmware.
 */
&acpm_ipc {
	pmic-1 {
		compatible = "samsung,s2mpg14-pmic";

		regulators {
			touch_avdd: ldo4m {
				regulator-name = "touch-avdd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			touch_vdd: ldo25m {
				regulator-name = "touch-vdd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};
		};
	};
};

&spi20 {
	status = "okay";

	/*
	 * ST FTM5 (SALIXP, chip id 36 40), as stock's fts node: 10 MHz,
	 * manual chip select. Not stock's axis inversion: salixp already
	 * reports in the panel's orientation.
	 */
	touchscreen@0 {
		compatible = "st,salixp";
		reg = <0>;
		spi-max-frequency = <10000000>;
		interrupt-parent = <&gpn0>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		vdd-supply = <&touch_vdd>;
		avdd-supply = <&touch_avdd>;
		reset-gpios = <&gpp21 2 GPIO_ACTIVE_LOW>;
		touchscreen-size-x = <1344>;
		touchscreen-size-y = <2992>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts_irq &ts_reset>;
	};
};

&usb_dwc3 {
	status = "okay";
};

&usb_hsphy {
	status = "okay";
};

&usbdrd_phy {
	status = "okay";
};

/*
 * Behind the init's storage guard (only slot B's boot images and userdata
 * writable), which runs before the disks appear.
 */
&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

&usi2_hsi0 {
	status = "okay";
};

/*
 * MAX77759 (charger, Type-C port controller, fuel gauge, PMIC) on USI11 /
 * hsi2c_11. Like the Pixel 7 Pro's, but the interrupt lines are on gpa7 and
 * gpa8. The bus and CMU_PERIC1 stay disabled here, and a bring-up overlay
 * enables them. Binding the PMIC at 0x66 also creates its charger cell,
 * and the charger driver then programs charge limits from the battery
 * node, so max77759_charger, gpio_max77759, nvmem_max77759 and tcpci_maxim
 * have to be kept from loading until each step is tested. The husky device
 * package does not block them yet (cheetah's omamobile-max77759.conf
 * does), and has to before an overlay that enables this bus ships.
 *
 * The fuel gauge has no battery model yet: the pack (ATL or COS, stock
 * reads its ID resistor) is not known, and a wrong model would be written
 * if the gauge reports power-on reset. The Type-C controller stays disabled,
 * as on the Pixel 7 Pro: USB is the only way into the phone.
 */
&hsi2c_11 {
	clock-frequency = <400000>;

	usb-typec@25 {
		compatible = "maxim,max77759-tcpci", "maxim,max33359";
		reg = <0x25>;
		interrupts-extended = <&gpa8 3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&typec_int>;
		pinctrl-names = "default";
		status = "disabled";

		/*
		 * Sink only: VBUS for host mode comes from an external boost
		 * (stock: max77759,ext-otg-only, MAX77759 GPIO5 "bst-on" and
		 * the TCPC's EXTBST_CTRL), which has no driver yet. MAX77759
		 * GPIO6 is the VBUS input switch (stock in-switch-gpio): leave
		 * it alone.
		 */
		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "sink";
			self-powered;
			op-sink-microwatt = <2600000>;
			sink-pdos = <PDO_FIXED(5000, 3000,
					       (PDO_FIXED_DATA_SWAP
						| PDO_FIXED_USB_COMM
						| PDO_FIXED_HIGHER_CAP
						| PDO_FIXED_DUAL_ROLE))
				     PDO_FIXED(9000, 2200, 0)
				     PDO_PPS_APDO(5000, 11000, 3000)>;
			pd-disable;
			typec-power-opmode = "default";
		};
	};

	fuel-gauge@36 {
		compatible = "maxim,max77759-fg";
		reg = <0x36>;
		interrupts-extended = <&gpa7 7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_fg_int>;
		pinctrl-names = "default";
		shunt-resistor-micro-ohms = <5000>;
		monitored-battery = <&battery>;
	};

	pmic@66 {
		compatible = "maxim,max77759";
		reg = <0x66>;
		interrupts-extended = <&gpa8 0 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_int>;
		pinctrl-names = "default";
		interrupt-controller;
		#interrupt-cells = <2>;
		/* for the charger cell */
		monitored-battery = <&battery>;

		gpio {
			compatible = "maxim,max77759-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};

/*
 * The battery pack's EEPROM on USI9 / hsi2c_9 (stock: "at,24c08" at 0x50 on
 * a 400 kHz bus, in the pack and powered by it). Byte 0x17 is the battery ID
 * that Google's driver matches against the gauge models; the rest is the
 * pack's part number, dates and history, so it is read-only here. The bus
 * and USI9 stay disabled; a bring-up overlay enables them. Nothing reads the
 * ID into the gauge yet.
 */
&hsi2c_9 {
	clock-frequency = <400000>;

	eeprom@50 {
		compatible = "atmel,24c08";
		reg = <0x50>;
		pagesize = <16>;
		read-only;
	};
};
