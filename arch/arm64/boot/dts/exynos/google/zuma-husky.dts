// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 8 Pro (husky) - first-light board file.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "zuma.dtsi"

/ {
	model = "Google Pixel 8 Pro";
	compatible = "google,zuma-husky", "google,zuma";

	/*
	 * zuma's ABL picks the base DTB by matching these children against
	 * the SoC's product id, revision and package; there is no /soc_id.
	 * A retail husky has a B0/B1 FOPLP part (stock base DTB 2, which
	 * carries exactly these two).
	 */
	soc_compatible {
		B0_FOPLP {
			product_id = <0x9865>;
			major = <1>;
			minor = <0>;
			pkg_mode = <0>;
		};

		B1_FOPLP {
			product_id = <0x9865>;
			major = <1>;
			minor = <1>;
			pkg_mode = <0>;
		};
	};

	/*
	 * UFS VCC, switched by gpp0-1 as on stock. ABL hands over with it
	 * off, so the UFS driver must turn it on.
	 */
	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * WL_REG_ON of the BCM4398 (gph3-4, stock's wl_reg_on). Modelled as
	 * the root port's supply so the PCI pwrctrl core switches it around
	 * link training; bcmdhd waits 200 ms after raising it. With pcie_1
	 * disabled nothing enables it, so the chip stays off.
	 */
	wlan_pwr: regulator-wlan {
		compatible = "regulator-fixed";
		regulator-name = "wlan-reg-on";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gph3 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <200000>;
		pinctrl-0 = <&wlan_reg_on>;
		pinctrl-names = "default";
	};

	chosen {
		/*
		 * ABL requires bootargs to exist; it appends its own after these.
		 * reboot=warm: a cold PSCI reset clears the reboot reason in
		 * SYSIP_DAT0 before ABL reads it, so "reboot bootloader" would
		 * only boot the slot again.
		 * The watchdog driver stops the bootloader's watchdogs, so a
		 * hang that never panics lasts until someone holds Power and
		 * Volume Up: panic on soft and hard lockups and on RCU stalls,
		 * so that panic=10 resets the phone by itself.
		 */
		bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.panic_on_rcu_stall=1 clk_ignore_unused pd_ignore_unused rdinit=/init";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * ABL's splash, still scanned out at handover: DPP0's
		 * RDMA_BASEADDR_P0 (0x19900040) reads 0xfac00000 on a booted
		 * phone, as on the Pixel 7 Pro. The panel is DSI command mode,
		 * so new frames reach it only once DECON0's trigger is unmasked.
		 */
		framebuffer0: framebuffer {
			compatible = "simple-framebuffer";
			memory-region = <&cont_splash_mem>;
			width = <1344>;
			height = <2992>;
			stride = <(1344 * 4)>;
			format = "a8r8g8b8";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa4 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa6 2 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa4 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 (1344 * 2992 * 4)>;
			no-map;
		};

		/*
		 * All of the Wi-Fi chip's DMA buffers come from this pool, below
		 * 4 GiB, as on the Pixel 7 Pro: it keeps driver bugs and stray
		 * pointers away from the rest of RAM. It does not confine the
		 * chip's own firmware.
		 */
		wifi_dma_pool: wifi-dma-pool {
			compatible = "restricted-dma-pool";
			size = <0x1000000>;
			alignment = <0x0 0x200000>;
			alloc-ranges = <0x0 0x80000000 0x80000000>;
		};
	};
};

/*
 * The main PMIC, behind the ACPM firmware. Its regulators are described
 * with their consumers, which run them through the firmware.
 */
&acpm_ipc {
	pmic-1 {
		compatible = "samsung,s2mpg14-pmic";

		regulators {
			touch_avdd: ldo4m {
				regulator-name = "touch-avdd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			touch_vdd: ldo25m {
				regulator-name = "touch-vdd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};
		};
	};
};

/*
 * Wi-Fi: the BCM4398 on pcie_1, one Gen3 lane as on stock. Its DMA
 * buffers come from wifi_dma_pool.
 */
&pcie_1 {
	pinctrl-0 = <&pcie1_clkreq>, <&pcie1_perst>, <&wlan_dev_wake>,
		    <&wlan_host_wake>;
	status = "okay";

	pcie@0,0 {
		compatible = "pciclass,0604";
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		bus-range = <0x01 0xff>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		vpcie3v3-supply = <&wlan_pwr>;

		wifi@0,0 {
			compatible = "pci14e4,4444";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			brcm,board-type = "google,zuma-husky";
			memory-region = <&wifi_dma_pool>;
		};
	};
};

&pcie_1_phy {
	status = "okay";
};

&pinctrl_far_alive {
	wlan_host_wake: wlan-host-wake-pins {
		samsung,pins = "gpa5-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_DOWN>;
	};
};

&pinctrl_hsi2 {
	wlan_reg_on: wlan-reg-on-pins {
		samsung,pins = "gph3-4";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_NONE>;
	};

	wlan_dev_wake: wlan-dev-wake-pins {
		samsung,pins = "gph3-5";
		samsung,pin-function = <GS101_PIN_FUNC_INPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_DOWN>;
	};
};

&spi20 {
	status = "okay";

	/*
	 * ST FTM5 (SALIXP, chip id 36 40), as stock's fts node: 10 MHz,
	 * manual chip select. Not stock's axis inversion: salixp already
	 * reports in the panel's orientation.
	 */
	touchscreen@0 {
		compatible = "st,salixp";
		reg = <0>;
		spi-max-frequency = <10000000>;
		interrupt-parent = <&gpn0>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		vdd-supply = <&touch_vdd>;
		avdd-supply = <&touch_avdd>;
		reset-gpios = <&gpp21 2 GPIO_ACTIVE_LOW>;
		touchscreen-size-x = <1344>;
		touchscreen-size-y = <2992>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts_irq &ts_reset>;
	};
};

&usb_dwc3 {
	status = "okay";
};

&usb_hsphy {
	status = "okay";
};

&usbdrd_phy {
	status = "okay";
};

/*
 * Behind the init's storage guard (only slot B's boot images and userdata
 * writable), which runs before the disks appear.
 */
&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

&usi2_hsi0 {
	status = "okay";
};
