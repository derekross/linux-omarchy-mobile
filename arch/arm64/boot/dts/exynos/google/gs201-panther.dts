// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 7 (panther) - first-light board file.
 *
 * USB (NCM + ACM), the cluster watchdogs from gs201.dtsi, a
 * simple-framebuffer on the buffer ABL leaves DPP0 scanning out, UFS, the
 * three keys, the touchscreen with its rails on the main PMIC, the GPU, the
 * haptics, the MAX77759's I2C bus with its fuel gauge, and the display
 * through gs-decon, which takes over from the simple-framebuffer.
 */

/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>
#include "gs201.dtsi"

/ {
	model = "Google Pixel 7";
	compatible = "google,gs201-panther", "google,gs201";

	/*
	 * ABL's base-DTB match: product id 0x09855000 | major revision (B0 is
	 * 1). Stock reports pkg_mode 0 and soc_id 0x09855001 in its live tree.
	 */
	soc_id = <0x09855001 0x0>;

	chosen {
		/* ABL requires bootargs to exist; it appends its own after these. */
		bootargs = "console=tty0 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init omamobile.ufs-probe mem_sleep_default=s2idle";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * ABL leaves DECON0 -> DSIM0 -> panel (sdc-s6e3fc3) running in
		 * command mode with DPP0 scanning 0xfac00000 (RDMA_BASEADDR_Y8,
		 * read on this phone). simplefb scans it out and takes the size
		 * from this node until gs-decon takes the screen over.
		 */
		framebuffer0: framebuffer@fac00000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
			memory-region = <&cont_splash_mem>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	battery: battery {
		compatible = "simple-battery";
		/* google,chg-battery-capacity in the live tree */
		charge-full-design-microamp-hours = <4277000>;
		/* google,fv-max-uv; VEmpty of the live tree's gauge models */
		voltage-max-design-microvolt = <4450000>;
		voltage-min-design-microvolt = <3300000>;
	};

	/* The same pins as cheetah's (Google's gs201-common.dtsi). */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa10 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa8 5 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		/*
		 * PMIC_PWRON_OD_L: the S2MPG12 PWRONB line, also wired to the
		 * SoC. The PMIC's own long-press reset is unaffected.
		 */
		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa10 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	/*
	 * UFS VCC. Stock drives it from GPIO gpp0-1 (boot-on), as on
	 * cheetah; there is no gs201 GPIO driver yet, so describe it as
	 * always on, as the bootloader leaves it.
	 */
	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		regulator-always-on;
		regulator-boot-on;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * Stock's region and layout (ramoops_mem@fd3ff000 in its live
		 * tree), so a log from this kernel can be read after a warm
		 * reboot into slot A.
		 */
		ramoops@fd3ff000 {
			compatible = "ramoops";
			reg = <0x0 0xfd3ff000 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
			no-map;
		};

		/*
		 * Scanout buffers for gs-decon: DPP0 takes 32-bit addresses and
		 * the DPU SysMMU is bypassed. Room for five 1080x2400 XRGB8888
		 * buffers. Reusable, so the pages serve movable allocations
		 * while unused.
		 */
		display_pool: display-pool {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x3800000>;
			/* read with the root's #address-cells (2), not #size-cells */
			alignment = <0x0 0x200000>;
			alloc-ranges = <0x0 0x80000000 0x80000000>;
		};
	};
};

&acpm_ipc {
	/*
	 * Main PMIC, touch rails only. LDO25M is the touch controller's VDD
	 * and LDO26M its AVDD; nothing else on the stock board consumes
	 * them. Stock constrains them to 1.6-1.95 V and 2.5-3.0 V. The sub-PMIC
	 * is not described.
	 */
	pmic-1 {
		compatible = "samsung,s2mpg12-pmic";
		interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>;
		google,vgpio2ap-sysreg = <&sysreg_vgpio2ap>;
		wakeup-source;

		regulators {
			/* Stock's 1.8 V, which ABL leaves programmed */
			ldo25m: ldo25m {
				regulator-name = "vdd-ts";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			/*
			 * ABL leaves 3.3 V programmed, above stock's range;
			 * stock's regulator core lowers it to 3.0 V before
			 * the touch driver switches it on.
			 */
			ldo26m: ldo26m {
				regulator-name = "avdd-ts";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};
		};
	};
};

/*
 * Display bring-up (device/panther/DISPLAY-PLAN.md): the DPU and DISP clock
 * controllers, and DSIM0 with the panel (gate D1), so the panel driver can
 * take the bootloader's panel over and send it DCS commands.
 */
&cmu_disp {
	status = "okay";
};

&cmu_dpu {
	status = "okay";
};

/*
 * Flip-only KMS on the bootloader's pipeline (gate D3): gs-decon takes the
 * screen over from simpledrm once it and the DSIM and panel drivers have
 * probed.
 */
&decon0 {
	memory-region = <&display_pool>, <&cont_splash_mem>;
	memory-region-names = "pool", "boot-framebuffer";
	status = "okay";
};

&dsi0 {
	status = "okay";

	panel@0 {
		compatible = "samsung,s6e3fc3-p10";
		reg = <0>;
		/* high = running; the bootloader leaves it high */
		reset-gpios = <&gpa7 1 GPIO_ACTIVE_LOW>;
		/* vci (S2MPG12 LDO27M) and vddi (S2MPG13 BUCKA): no driver yet */
		width-mm = <66>;
		height-mm = <146>;
	};
};

&gpu {
	/* No mali-supply: the G3D rails follow the PMU power domain and ACPM. */
	status = "okay";
};

&usbdrd31_phy {
	status = "okay";
};

&usb_dwc3 {
	status = "okay";
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

/*
 * MAX77759 (charger, Type-C port controller, fuel gauge) on USI13, as on
 * the Pixel 7 Pro: TCPC 0x25, PMIC 0x66, fuel gauge 0x36, charger 0x69,
 * bus pins gpp25-0/1. Only the fuel gauge is described: the Type-C port
 * controller would take over VBUS and the data role from the forced-VBUS
 * setup the USB PHY uses, and the USB link is our only way into the phone.
 */
&usi13 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_13 {
	clock-frequency = <400000>;
	status = "okay";

	fuel-gauge@36 {
		compatible = "maxim,max77759-fg";
		reg = <0x36>;
		interrupts-extended = <&gpa9 3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_fg_int>;
		pinctrl-names = "default";
		/* maxim,rsense-default = <500> (10 uOhm units) in the live tree */
		shunt-resistor-micro-ohms = <5000>;
		monitored-battery = <&battery>;

		/*
		 * Battery model for the pack with a 1 kOhm ID resistor, the one
		 * this phone has (the gauge's TempCo read 0x1a02 under stock's
		 * driver, which is this model's). From Google's
		 * gs201-panther-battery-data.dtsi (cos-a1-1k, model version 2),
		 * except RelaxCfg 0x143b, the value stock writes over the
		 * model's at boot (r_regval_1720x). TaskPeriod 0x2d00 makes one
		 * capacity LSB 2 mAh with 5 mOhm: DesignCap 0x0873 = 4326 mAh.
		 */
		maxim,fg-model = /bits/ 16 <
			0x8c80 0xb770 0xb8f0 0xba50 0xbb40 0xbc30 0xbe00 0xbfd0
			0xc1b0 0xc3a0 0xc6b0 0xc9c0 0xd020 0xd300 0xd5e0 0xdc30
			0x0080 0x1070 0x1020 0x0ed0 0x0f00 0x1700 0x1530 0x0c20
			0x0c40 0x07f0 0x07f0 0x06f0 0x0710 0x06d0 0x06f0 0x06f0
			0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200
			0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200
		>;
		maxim,fg-params = /bits/ 16 <
			0xf060	/* IAvgEmpty */
			0x143b	/* RelaxCfg */
			0x260e	/* LearnCfg */
			0x4217	/* Config: external thermistor, TEx clear */
			0x0090	/* Config2 */
			0x5f00	/* FullSOCThr */
			0x0873	/* FullCapRep */
			0x0873	/* DesignCap */
			0x3200	/* dPAcc */
			0x021c	/* dQAcc */
			0x0873	/* FullCapNom */
			0xa561	/* VEmpty */
			0x1f00	/* QRTable00 */
			0x0d80	/* QRTable10 */
			0x0480	/* QRTable20 */
			0x0400	/* QRTable30 */
			0x0740	/* RComp0 */
			0x1a02	/* TempCo */
			0x0557	/* IChgTerm */
			0xed51	/* TGain */
			0x1eba	/* TOff */
			0x0014	/* Curve */
			0x3870	/* MiscCfg */
			0x1900	/* AtRate */
			0x2241	/* ConvgCfg */
			0xc613	/* FilterCfg */
			0x2d00	/* TaskPeriod */
		>;
	};
};

/*
 * Haptics: Cirrus Logic CS40L26A at 0x43 on PERIC0 USI8 (Google's I2C bus
 * 8), INTb on gpa8-1, RESET on gpp24-3, as on the Pixel 7 Pro. Boost and
 * actuator values are the stock ones, the same as the Pixel 7 Pro's
 * (bst-ipk 2.5 A, bst-ctl 11 V, f0 145 Hz, ReDC 13 ohm in the live tree).
 * The bus pins are on PERIC0 (gpp16-0/1).
 */
&pinctrl_far_alive {
	hapt_amp_irq: hapt-amp-irq-pins {
		samsung,pins = "gpa8-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_gpio_alive {
	if_pmic_fg_int: if-pmic-fg-int-pins {
		samsung,pins = "gpa9-3";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_peric0 {
	status = "okay";
};

&pinctrl_peric1 {
	hapt_amp_rst: hapt-amp-rst-pins {
		samsung,pins = "gpp24-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&usi8 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_8 {
	clock-frequency = <400000>;
	status = "okay";

	haptics: haptic-driver@43 {
		compatible = "cirrus,cs40l26a";
		reg = <0x43>;
		interrupts-extended = <&gpa8 1 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp24 3 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&hapt_amp_irq &hapt_amp_rst>;
		pinctrl-names = "default";
		cirrus,boost-peak-microamp = <2500000>;
		cirrus,boost-ctl-microvolt = <11000000>;
		cirrus,lra-f0-hz = <145>;
		cirrus,lra-redc-micro-ohms = <13000000>;
	};
};

/*
 * Touchscreen: a FocalTech FT3658 on USI0 SPI, wired as the Pixel 7 Pro's
 * S3908 (chip select gpp20-3, interrupt gpa7-0, reset gpp23-2).
 */
&ts_irq {
	/* Stock pulls the interrupt line up on this phone, not on the 7 Pro */
	samsung,pin-pud = <GS101_PIN_PULL_UP>;
};

&usi0 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi_0 {
	pinctrl-0 = <&spi0_bus &spi0_miso &spi0_cs_gpio>;
	cs-gpios = <&gpp20 3 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
	status = "okay";

	touchscreen@0 {
		compatible = "focaltech,ft3658";
		reg = <0>;
		spi-max-frequency = <10000000>;
		/* Stock's cs-clock-delay = <1>: 1 us from chip select to the clock */
		spi-cs-setup-delay-ns = <1000>;
		interrupt-parent = <&gpa7>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpp23 2 GPIO_ACTIVE_LOW>;
		vdd-supply = <&ldo25m>;
		avdd-supply = <&ldo26m>;
		pinctrl-0 = <&ts_irq &ts_reset>;
		pinctrl-names = "default";
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};
