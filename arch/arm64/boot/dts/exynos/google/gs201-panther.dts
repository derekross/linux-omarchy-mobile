// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 7 (panther) - first-light board file.
 *
 * USB (NCM + ACM), the cluster watchdogs from gs201.dtsi, a
 * simple-framebuffer on the buffer ABL leaves DPP0 scanning out, UFS and
 * the three keys. The panel driver, touch and the GPU stay disabled.
 */

/dts-v1/;

#include <dt-bindings/input/input.h>
#include "gs201.dtsi"

/ {
	model = "Google Pixel 7";
	compatible = "google,gs201-panther", "google,gs201";

	/*
	 * ABL's base-DTB match: product id 0x09855000 | major revision (B0 is
	 * 1). Stock reports pkg_mode 0 and soc_id 0x09855001 in its live tree.
	 */
	soc_id = <0x09855001 0x0>;

	chosen {
		/* ABL requires bootargs to exist; it appends its own after these. */
		bootargs = "console=tty0 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init omamobile.ufs-probe";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * ABL leaves DECON0 -> DSIM0 -> panel (sdc-s6e3fc3) running in
		 * command mode with DPP0 scanning 0xfac00000 (RDMA_BASEADDR_Y8,
		 * read on this phone). There is no panel driver, so no panel
		 * phandle; the size comes from this node.
		 */
		framebuffer0: framebuffer@fac00000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
			memory-region = <&cont_splash_mem>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/* The same pins as cheetah's (Google's gs201-common.dtsi). */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa10 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa8 5 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		/*
		 * PMIC_PWRON_OD_L: the S2MPG12 PWRONB line, also wired to the
		 * SoC. The PMIC's own long-press reset is unaffected.
		 */
		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa10 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	/*
	 * UFS VCC. Stock drives it from GPIO gpp0-1 (boot-on), as on
	 * cheetah; there is no gs201 GPIO driver yet, so describe it as
	 * always on, as the bootloader leaves it.
	 */
	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		regulator-always-on;
		regulator-boot-on;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * Stock's region and layout (ramoops_mem@fd3ff000 in its live
		 * tree), so a log from this kernel can be read after a warm
		 * reboot into slot A.
		 */
		ramoops@fd3ff000 {
			compatible = "ramoops";
			reg = <0x0 0xfd3ff000 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
			no-map;
		};
	};
};

&usbdrd31_phy {
	status = "okay";
};

&usb_dwc3 {
	status = "okay";
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};
