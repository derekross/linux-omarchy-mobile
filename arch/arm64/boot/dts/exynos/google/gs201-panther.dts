// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 7 (panther) - first-light board file.
 *
 * USB (NCM + ACM), the cluster watchdogs from gs201.dtsi, a
 * simple-framebuffer on the buffer ABL leaves DPP0 scanning out, UFS, the
 * three keys, the touch rails on the main PMIC, the GPU and the haptics.
 * The panel driver and touch stay disabled.
 */

/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>
#include "gs201.dtsi"

/ {
	model = "Google Pixel 7";
	compatible = "google,gs201-panther", "google,gs201";

	/*
	 * ABL's base-DTB match: product id 0x09855000 | major revision (B0 is
	 * 1). Stock reports pkg_mode 0 and soc_id 0x09855001 in its live tree.
	 */
	soc_id = <0x09855001 0x0>;

	chosen {
		/* ABL requires bootargs to exist; it appends its own after these. */
		bootargs = "console=tty0 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init omamobile.ufs-probe mem_sleep_default=s2idle";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * ABL leaves DECON0 -> DSIM0 -> panel (sdc-s6e3fc3) running in
		 * command mode with DPP0 scanning 0xfac00000 (RDMA_BASEADDR_Y8,
		 * read on this phone). There is no panel driver, so no panel
		 * phandle; the size comes from this node.
		 */
		framebuffer0: framebuffer@fac00000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
			memory-region = <&cont_splash_mem>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/* The same pins as cheetah's (Google's gs201-common.dtsi). */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa10 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa8 5 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		/*
		 * PMIC_PWRON_OD_L: the S2MPG12 PWRONB line, also wired to the
		 * SoC. The PMIC's own long-press reset is unaffected.
		 */
		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa10 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	/*
	 * UFS VCC. Stock drives it from GPIO gpp0-1 (boot-on), as on
	 * cheetah; there is no gs201 GPIO driver yet, so describe it as
	 * always on, as the bootloader leaves it.
	 */
	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		regulator-always-on;
		regulator-boot-on;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * Stock's region and layout (ramoops_mem@fd3ff000 in its live
		 * tree), so a log from this kernel can be read after a warm
		 * reboot into slot A.
		 */
		ramoops@fd3ff000 {
			compatible = "ramoops";
			reg = <0x0 0xfd3ff000 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
			no-map;
		};
	};
};

&acpm_ipc {
	/*
	 * Main PMIC, touch rails only. LDO25M is the touch controller's VDD
	 * and LDO26M its AVDD; nothing else on the stock board consumes
	 * them. Stock constrains them to 1.6-1.95 V and 2.5-3.0 V. The sub-PMIC
	 * is not described.
	 */
	pmic-1 {
		compatible = "samsung,s2mpg12-pmic";
		interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>;
		google,vgpio2ap-sysreg = <&sysreg_vgpio2ap>;
		wakeup-source;
		status = "disabled";

		regulators {
			/* Stock's 1.8 V, which ABL leaves programmed */
			ldo25m: ldo25m {
				regulator-name = "vdd-ts";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			/*
			 * ABL leaves 3.3 V programmed, above stock's range;
			 * stock's regulator core lowers it to 3.0 V before
			 * the touch driver switches it on.
			 */
			ldo26m: ldo26m {
				regulator-name = "avdd-ts";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};
		};
	};
};

&gpu {
	/* No mali-supply: the G3D rails follow the PMU power domain and ACPM. */
	status = "okay";
};

&usbdrd31_phy {
	status = "okay";
};

&usb_dwc3 {
	status = "okay";
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

/*
 * Haptics: Cirrus Logic CS40L26A at 0x43 on PERIC0 USI8 (Google's I2C bus
 * 8), INTb on gpa8-1, RESET on gpp24-3, as on the Pixel 7 Pro. Boost and
 * actuator values are the stock ones, the same as the Pixel 7 Pro's
 * (bst-ipk 2.5 A, bst-ctl 11 V, f0 145 Hz, ReDC 13 ohm in the live tree).
 * The bus pins are on PERIC0 (gpp16-0/1).
 */
&pinctrl_far_alive {
	hapt_amp_irq: hapt-amp-irq-pins {
		samsung,pins = "gpa8-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_peric0 {
	status = "okay";
};

&pinctrl_peric1 {
	hapt_amp_rst: hapt-amp-rst-pins {
		samsung,pins = "gpp24-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&usi8 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_8 {
	clock-frequency = <400000>;
	status = "okay";

	haptics: haptic-driver@43 {
		compatible = "cirrus,cs40l26a";
		reg = <0x43>;
		interrupts-extended = <&gpa8 1 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp24 3 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&hapt_amp_irq &hapt_amp_rst>;
		pinctrl-names = "default";
		cirrus,boost-peak-microamp = <2500000>;
		cirrus,boost-ctl-microvolt = <11000000>;
		cirrus,lra-f0-hz = <145>;
		cirrus,lra-redc-micro-ohms = <13000000>;
	};
};
