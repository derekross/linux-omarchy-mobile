/dts-v1/;

#include <dt-bindings/leds/common.h>
#include "gs101-pixel-common.dtsi"

/ {
	model = "Raven";
	compatible = "google,gs101-raven", "google,gs101";

	/*
	 * ABL picks the base DTB by soc_id (product id 0x09845000 | major
	 * revision); the factory vendor_boot carries one per revision. B0 = 1.
	 */
	soc_id = <0x09845001 0x0>;

	chosen {
		/*
		 * ABL appends its own arguments (console=null among them), so a
		 * panic is silent: panic=10 reboots instead of hanging. init hands
		 * over to the Arch root on userdata when it finds one.
		 */
		bootargs = "console=tty0 panic=10 clk_ignore_unused rdinit=/init";
	};

	battery: battery {
		compatible = "simple-battery";
		/* google,chg-battery-capacity */
		charge-full-design-microamp-hours = <4905000>;
		/*
		 * Charger limits without Google's step charging: the float
		 * voltage is google,fv-max-uv, the top of google,chg-cv-limits
		 * (4.2/4.3/4.45 V). The fast charge current is 0.3 C, the
		 * lowest google,chg-cc-limits entry at any voltage tier from
		 * 10 to 46 degC, rounded down to a charger selector (0x16).
		 */
		constant-charge-voltage-max-microvolt = <4450000>;
		constant-charge-current-max-microamp = <1466730>;
	};
};

&acpm_ipc {
	/*
	 * ABL leaves the memory bus at 2028 MHz and nothing scales it yet.
	 * 1014 MHz saved about 70 mA, as much as stock's
	 * 421 MHz idle, with headroom for the display and the GPU.
	 */
	assigned-clocks = <&acpm_ipc GS101_CLK_ACPM_DVFS_MIF>;
	assigned-clock-rates = <1014000000>;

	pmic-2 {
		regulators {
			ldo4s {
				regulator-name = "vdd2_uwb";
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <3300000>;
			};

			ldo14s {
				regulator-name = "vdd3_uwb";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
			};
		};
	};
};

/* Bluetooth: the BCM4389 on the APM USI1 UART (Google's gs101-common-bluetooth) */
&usi_apm1 {
	status = "okay";
};

&serial_apm1 {
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4389-bt";
		shutdown-gpios = <&gpp16 2 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpp14 3 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpa6 6 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "host-wakeup";
		pinctrl-0 = <&bt_reg_on &bt_dev_wake &bt_host_wake>;
		pinctrl-names = "default";
		max-speed = <3000000>;
	};
};

&acpm_tmu {
	status = "okay";
};

/* Unused blocks the bootloader leaves powered: genpd turns them off */
&pd_g2d {
	status = "okay";
};

&pd_mfc {
	status = "okay";
};

&pd_csis {
	status = "okay";
};

&pd_pdp {
	status = "okay";
};

&pd_dns {
	status = "okay";
};

&pd_g3aa {
	status = "okay";
};

&pd_ipp {
	status = "okay";
};

&pd_itp {
	status = "okay";
};

&pd_mcsc {
	status = "okay";
};

&pd_gdc {
	status = "okay";
};

&pd_tnr {
	status = "okay";
};

&pd_bo {
	status = "okay";
};

&pd_tpu {
	status = "okay";
};

&cont_splash_mem {
	reg = <0x0 0xfac00000 (1440 * 3120 * 4)>;

	status = "okay";
};

&framebuffer0 {
	width = <1440>;
	height = <3120>;
	stride = <(1440 * 4)>;
	format = "a8r8g8b8";

	status = "okay";
};

/* The Mali-G78 MP20 on its S2MPG10/11 rails, as postmarketOS describes them */
&gpu {
	mali-supply = <&s2mpg11_buck2s>;
	g3d-l2-supply = <&s2mpg11_buck8s>;
	g3d-m-supply = <&s2mpg11_ldo1s>;
	int-m-supply = <&s2mpg10_buck7m>;

	status = "okay";
};

/* Bluetooth's control lines, as Google's gs101-common-bluetooth.dtsi sets them */
&pinctrl_far_alive {
	bt_host_wake: bt-host-wake-pins {
		samsung,pins = "gpa6-6";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_peric0 {
	bt_dev_wake: bt-dev-wake-pins {
		samsung,pins = "gpp14-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	bt_reg_on: bt-reg-on-pins {
		samsung,pins = "gpp16-2";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

/*
 * Touch: a Samsung S6SY79x on SPI 11 (Google's gs101-sec-touch.dtsi and
 * gs101-common-touch.dtsi): 10 MHz, mode 3, interrupt on gpa9-0, an
 * active-low reset on gpp26-0 (sec_ts drives it 0 until powered, then
 * 1, 0, 1), DVDD on LDO25M and AVDD on LDO26M, which
 * gs101-raven-touch.dtsi pins to 1.8 V and 3.3 V.
 */
&usi11 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi_11 {
	cs-gpios = <&gpp23 3 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
	pinctrl-0 = <&spi11_bus &spi11_cs>;
	status = "okay";

	touchscreen@0 {
		compatible = "samsung,s6sy792";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-cpol;
		spi-cpha;
		interrupt-parent = <&gpa9>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp26 0 GPIO_ACTIVE_LOW>;
		vdd-supply = <&{/firmware/power-management/pmic-1/regulators/ldo25m}>;
		avdd-supply = <&{/firmware/power-management/pmic-1/regulators/ldo26m}>;
		touchscreen-size-x = <1440>;
		touchscreen-size-y = <3120>;
	};
};

/* TS_SPI_SEL: low gives the touch controller's bus to the AP, not the AoC */
&gpp26 {
	ts-spi-sel-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "ts-spi-sel";
	};
};

&{/firmware/power-management/pmic-1/regulators/ldo25m} {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&{/firmware/power-management/pmic-1/regulators/ldo26m} {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

/*
 * The CPU zones report the cluster hotspot through ACPM, which can jump by
 * 30 °C for one sample under a short burst of load. Google's raven
 * throttles from 90 °C and only has a "hot" trip at 115 °C: keep our
 * throttling from 75 °C and power off at a sustained 115 °C. The GPU zone
 * gets the same until it has GPU cooling: a panfrost burst may spike it
 * the same way. The bootloader sets the TMU's own hardware trip at 115 °C
 * too, so this trip is a backstop: a sustained overheat may end in that
 * hardware reset rather than an orderly shutdown.
 */
&big_crit {
	temperature = <115000>;
};

&mid_crit {
	temperature = <115000>;
};

&little_crit {
	temperature = <115000>;
};

&gpu_crit {
	temperature = <115000>;
};

&reserved_memory {
	/*
	 * Same region and layout as Google's gs101 kernel, so a log written by
	 * this kernel survives a warm reset and can be read from
	 * /sys/fs/pstore on the next boot.
	 */
	ramoops@fd3ff000 {
		compatible = "ramoops";
		reg = <0x0 0xfd3ff000 0x400000>;
		console-size = <0x200000>;
		pmsg-size = <0x200000>;
	};
};

&pmic {
	/* for the charger cell */
	monitored-battery = <&battery>;
};

/*
 * Rear flash LED: TI LM3644 at 0x63 on PERIC0 USI7 (Google's I2C bus 7, also
 * the cameras' bus), HWEN on gpp23-6, as stock's raven device tree
 * describes it. Stock drives it from the camera HAL through LWIS; torch only
 * here, with cheetah's bring-up cap (not a stock value).
 */
&usi7 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_7 {
	clock-frequency = <370000>;
	status = "okay";

	led-controller@63 {
		compatible = "ti,lm3644";
		reg = <0x63>;
		enable-gpios = <&gpp23 6 GPIO_ACTIVE_HIGH>;

		led {
			function = LED_FUNCTION_TORCH;
			color = <LED_COLOR_ID_WHITE>;
			led-sources = <1 2>;
			led-max-microamp = <50000>;
		};
	};
};

/*
 * Haptics: a Cirrus Logic CS40L25A at 0x43 (Google's gs101-raviole-audio.dtsi),
 * reset on gpp24-0, active low. Its interrupt (gpa6-5) isn't used yet.
 */
&hsi2c_8 {
	haptics@43 {
		compatible = "cirrus,cs40l25a";
		reg = <0x43>;
		reset-gpios = <&gpp24 0 GPIO_ACTIVE_LOW>;
		/* stock's boost: 4.5 A peak, 7.5 V (CLAB) */
		cirrus,boost-peak-microamp = <4500000>;
		cirrus,boost-ctl-microvolt = <7500000>;
	};
};
