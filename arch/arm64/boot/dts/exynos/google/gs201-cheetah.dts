// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 7 Pro (cheetah) - M1 bring-up board file.
 */

/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/media/video-interfaces.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>
#include <dt-bindings/usb/pd.h>
#include "gs201.dtsi"

/ {
	model = "Google Pixel 7 Pro";
	compatible = "google,gs201-cheetah", "google,gs201";

	/*
	 * ABL base-DTB match: (product id 0x09855000 | major rev). B0 = 1.
	 * Ship a second copy with 0x09855000 in the dtb section to be safe.
	 */
	soc_id = <0x09855001 0x0>;

	aliases {
		spi0 = &spi_0;
		spi5 = &spi_5;
	};

	chosen {
		/*
		 * ABL requires bootargs to exist; it appends its own after these.
		 * mem_sleep_default=s2idle: the firmware offers PSCI system
		 * suspend, so "mem" would otherwise mean "deep", which needs a
		 * PMU sleep sequence the kernel doesn't have yet.
		 */
		bootargs = "console=tty0 fbcon=font:TER16x32 quiet splash plymouth.force-scale=1 vt.global_cursor_default=0 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init omamobile.ufs-probe mem_sleep_default=s2idle";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		framebuffer0: framebuffer@fac00000 {
			compatible = "simple-framebuffer";
			memory-region = <&cont_splash_mem>;
			width = <1440>;
			height = <3120>;
			stride = <(1440 * 4)>;
			format = "a8r8g8b8";
			panel = <&panel>;
			/*
			 * Only the panel's size is read; simplefb must not wait for
			 * the panel device (it appears with the DSI host driver).
			 */
			post-init-providers = <&panel>;
		};
	};

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <4926000>;
		/* Google's fv-max-uv; VEmpty of the gauge model */
		voltage-max-design-microvolt = <4450000>;
		voltage-min-design-microvolt = <3300000>;
		/*
		 * Charger limits without Google's step charging: the float
		 * voltage is fv-max-uv, the top of google,chg-cv-limits
		 * (4.2/4.3/4.45 V). The fast charge current is 0.3 C, the
		 * lowest google,chg-cc-limits entry at any voltage tier from
		 * 10 to 46 degC, and a charger selector (0x16) exactly.
		 */
		constant-charge-voltage-max-microvolt = <4450000>;
		constant-charge-current-max-microamp = <1466730>;
	};

	/*
	 * Goodix optical under-display fingerprint sensor. Trusty owns its SPI
	 * bus; Linux only switches its supply, reset and interrupt lines.
	 * Disabled until the fingerprint bring-up gates: it needs Trusty, and
	 * its supply needs the sub-PMIC (pmic-2) enabled.
	 */
	fingerprint {
		compatible = "goodix,g7-udfps";
		interrupt-parent = <&gpa9>;
		interrupts = <2 IRQ_TYPE_EDGE_RISING>;
		reset-gpios = <&gpp1 1 GPIO_ACTIVE_LOW>;
		vdd-supply = <&ldo15s>;
		pinctrl-0 = <&fp_irq &fp_reset>;
		pinctrl-names = "default";
		status = "disabled";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa10 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa8 5 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		/*
		 * PMIC_PWRON_OD_L: the S2MPG12 PWRONB line, also wired to the
		 * SoC. The PMIC's own long-press reset is unaffected.
		 */
		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa10 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	/*
	 * UFS VCC. Google drives it from GPIO gpp0-1 (boot-on); there is no
	 * gs201 GPIO driver yet, so describe it as always on, as the
	 * bootloader leaves it.
	 */
	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * WL_REG_ON of the BCM4389. Google raises it and waits 200 ms before
	 * training the link (WIFI_TURNON_DELAY in bcmdhd). Modelled as the
	 * root port's supply so the PCI pwrctrl core switches it around link
	 * training. With pcie_1 disabled nothing enables it, so the chip
	 * stays off.
	 */
	wlan_pwr: regulator-wlan {
		compatible = "regulator-fixed";
		regulator-name = "wlan-reg-on";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gph2 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <200000>;
		pinctrl-0 = <&wlan_reg_on>;
		pinctrl-names = "default";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * All of the Wi-Fi chip's DMA buffers come from this pool. It
		 * keeps driver bugs and stray pointers away from the rest of
		 * RAM; it does not stop the chip's own firmware from reaching
		 * other memory (the HSI2 SysMMU and S2MPU see the PCIe and UFS
		 * masters on the same VID, so neither can confine it alone).
		 */
		wifi_dma_pool: wifi-dma-pool {
			compatible = "restricted-dma-pool";
			size = <0x1000000>;
			alignment = <0x0 0x200000>;
			/* the chip's writes above 4 GiB are not seen */
			alloc-ranges = <0x0 0x80000000 0x80000000>;
		};

		/*
		 * Camera capture buffers: the CSIS WDMA takes 32-bit addresses
		 * and its SysMMU is left in bypass, so frames go to contiguous
		 * memory below 4 GiB. Four 12.5 MP RAW10 frames are about
		 * 63 MiB; reusable, so the pages serve movable allocations while
		 * no camera streams.
		 */
		camera_pool: camera-pool {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x8000000>;
			/* read with the root's #address-cells (2), not #size-cells */
			alignment = <0x0 0x200000>;
			alloc-ranges = <0x0 0x80000000 0x80000000>;
		};

		/* [I] verify against the ABL-injected node in /sys/firmware/fdt */
		/*
		 * Same region and layout as stock Android, so a log written by
		 * this kernel can be read from /sys/fs/pstore after a warm
		 * reboot into the stock slot.
		 */
		ramoops@fd3ff000 {
			compatible = "ramoops";
			reg = <0x0 0xfd3ff000 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 (1440 * 3120 * 4)>;
			no-map;
		};

		/*
		 * Scanout buffers for gs-decon: DPP0 takes 32-bit addresses and
		 * the DPU SysMMU is bypassed. Room for five 1440x3120 XRGB8888
		 * buffers. Reusable, so the pages serve movable allocations
		 * while unused.
		 */
		display_pool: display-pool {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x5c00000>;
			/* read with the root's #address-cells (2), not #size-cells */
			alignment = <0x0 0x200000>;
			alloc-ranges = <0x0 0x80000000 0x80000000>;
		};
	};
};

&acpm_ipc {
	/*
	 * Main PMIC, for its RTC (the wake-up timer for suspend tests). The
	 * driver only reads and writes the RTC and the interrupt masks; the
	 * rails stay as the bootloader set them. Disabled until proven on
	 * the phone (SUSPEND-PLAN.md).
	 */
	pmic-1 {
		compatible = "samsung,s2mpg12-pmic";
		interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>;
		google,vgpio2ap-sysreg = <&sysreg_vgpio2ap>;
		wakeup-source;
		status = "disabled";
	};

	/*
	 * Sub PMIC, for its LDOs (GNSS first). Only the LDO control
	 * registers are writable through it, and only rails described
	 * below can be switched; the rest have no constraints and are left
	 * as the bootloader set them. No interrupt yet (gpa0-1 on stock).
	 * Disabled until proven on the phone (GNSS-PLAN.md, G1).
	 */
	pmic-2 {
		compatible = "samsung,s2mpg13-pmic";
		status = "disabled";

		/*
		 * GPIO0 wakes the camera PMIC (SLG51002 chip select), GPIO1
		 * enables PP3200_BB_CAM and GPIO3 PP1300_CAM; the others are
		 * unused on cheetah. Nothing here switches a pin: only the
		 * camera nodes below, disabled until camera-pwr-test, do.
		 */
		pmic_2_gpio: gpio {
			compatible = "samsung,s2mpg13-gpio";
			gpio-controller;
			#gpio-cells = <2>;
		};

		regulators {
			/*
			 * GNSS: L9S_GNSS_CORE, L10S_GNSS_RF, L11S_GNSS_AUX.
			 * The ranges are stock's, so nothing sets a voltage
			 * at probe; they are switched by the GNSS driver.
			 */
			ldo9s: ldo9s {
				regulator-name = "vdd_gnss_core";
				regulator-min-microvolt = <725000>;
				regulator-max-microvolt = <1300000>;
			};

			ldo10s: ldo10s {
				regulator-name = "vdd_gnss_rf";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
			};

			ldo11s: ldo11s {
				regulator-name = "vdd_gnss_aux";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
			};

			/*
			 * Fingerprint: L15S_UDFPS_AVDD, the sensor's analog
			 * supply, with stock's range. Off at hand-off (stock
			 * keeps it on only through regulator-always-on);
			 * switched by the goodix-fp driver.
			 */
			ldo15s: ldo15s {
				regulator-name = "vdd_udfps";
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <3300000>;
			};

			/*
			 * L12S_CAMIO: the 1.8 V I/O supply of every camera
			 * sensor, EEPROM, actuator and the laser AF. Stock
			 * voltage. Disabled (so not described, and never
			 * switched) until camera-pwr-test.
			 */
			ldo12s: ldo12s {
				regulator-name = "vddio_cam";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				status = "disabled";
			};
		};
	};
};

&dsi0 {
	/*
	 * The bootloader leaves DECON0 -> DSIM0 -> panel running in command
	 * mode; simplefb scans out its framebuffer and reads the panel size
	 * here. Enabled only for display bring-up (DISPLAY-PLAN.md, gate D1).
	 */
	status = "okay";

	panel: panel@0 {
		compatible = "samsung,s6e3hc4";
		reg = <0>;
		/* high = running; the bootloader leaves it high */
		reset-gpios = <&gpa7 1 GPIO_ACTIVE_LOW>;
		/* vddi (S2MPG13 BUCKA), vddd (S2MPG12 LDO28), vci (LDO27): no driver yet */
		width-mm = <71>;
		height-mm = <155>;
	};
};

/*
 * Flip-only KMS on the bootloader's pipeline (DISPLAY-PLAN.md, D4a/D5d):
 * gs-decon takes the screen over from simpledrm once it and the DSIM and
 * panel drivers have probed.
 */
&decon0 {
	memory-region = <&display_pool>, <&cont_splash_mem>;
	memory-region-names = "pool", "boot-framebuffer";
	status = "okay";
};

/* Display bring-up, gate D1b: the DPU and DISP clock controllers. */
&cmu_dpu {
	status = "okay";
};

&cmu_disp {
	status = "okay";
};

&gpu {
	/* No mali-supply: the G3D rails follow the PMU power domain and ACPM. */
	status = "okay";
};

/* Touchscreen: Synaptics S3908 on USI0 SPI */
&usi0 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi_0 {
	pinctrl-0 = <&spi0_bus &spi0_miso &spi0_cs_gpio>;
	cs-gpios = <&gpp20 3 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
	status = "okay";

	/*
	 * The 1.8 V (VDD) and 3.3 V (AVDD) supplies are S2MPG12 LDO25M and
	 * LDO26M. There is no S2MPG12 regulator driver yet; the bootloader
	 * leaves both on.
	 */
	touchscreen@0 {
		compatible = "syna,s3908";
		reg = <0>;
		spi-max-frequency = <10000000>;
		interrupt-parent = <&gpa7>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp23 2 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&ts_irq &ts_reset>;
		pinctrl-names = "default";
		touchscreen-x-mm = <71>;
		touchscreen-y-mm = <154>;
	};
};

/*
 * Speaker amplifiers: two Cirrus Logic CS35L41 (revision B2) on PERIC0 USI7
 * SPI, from Google's gs201-cheetah-audio.dtsi. Chip select 0 is the top
 * speaker, which is also the earpiece; chip select 1 is the bottom
 * loudspeaker. Their audio port (TDM) is wired to the AoC audio DSP, so
 * without an AoC driver these nodes give register access only, no sound.
 *
 * The boost values are the stock ones, except the peak current: 2.5 A (stock
 * speaker playback) instead of the stock DT default of 3.5 A (voice calls),
 * until the bring-up gates in AUDIO-PLAN.md have passed. The inductor and
 * capacitor values select the boost loop coefficients and must stay as they
 * are. Everything stays disabled until a bring-up overlay enables it.
 */
/ {
	/* S2MPG13 BUCKA ("SA"), always on; no S2MPG13 regulator driver yet. */
	amp_va: regulator-amp-va {
		compatible = "regulator-fixed";
		regulator-name = "amp-va";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* The amplifiers' VP pins sit directly on VSYS (stock: V_SYS_DUMMY). */
	amp_vp: regulator-amp-vp {
		compatible = "regulator-fixed";
		regulator-name = "amp-vp";
		regulator-min-microvolt = <4200000>;
		regulator-max-microvolt = <4200000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&usi7 {
	samsung,mode = <USI_MODE_SPI>;
};

&spi_7 {
	pinctrl-0 = <&spi7_bus &spi7_miso &amp_top_cs &amp_bottom_cs>;
	cs-gpios = <&gpp14 3 GPIO_ACTIVE_LOW>, <&gpp22 1 GPIO_ACTIVE_LOW>;
	num-cs = <2>;

	amp_top: amplifier@0 {
		compatible = "cirrus,cs35l41";
		reg = <0>;
		#sound-dai-cells = <1>;
		interrupts-extended = <&gpa6 3 IRQ_TYPE_LEVEL_HIGH>;
		/* AMP1_RESET_L: the driver drives 1 to release reset */
		reset-gpios = <&gpp17 1 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&amp_top_irq &amp_top_rst>;
		pinctrl-names = "default";
		VA-supply = <&amp_va>;
		VP-supply = <&amp_vp>;
		sound-name-prefix = "Top";
		cirrus,subsystem-id = "cheetah";
		cirrus,boost-type = <0>;
		cirrus,boost-peak-milliamp = <2500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <30>;
		cirrus,asp-sdout-hiz = <3>;
		/* the stock protection firmware does not survive hibernation */
		cirrus,dsp-no-hibernate;
		/* GPIO2 = push-pull interrupt, active high */
		cirrus,gpio2-src-select = <5>;
		cirrus,gpio2-output-enable;
		status = "disabled";
	};

	amp_bottom: amplifier@1 {
		compatible = "cirrus,cs35l41";
		reg = <1>;
		#sound-dai-cells = <1>;
		interrupts-extended = <&gpa8 6 IRQ_TYPE_LEVEL_HIGH>;
		/* AMP2_RESET_L: the driver drives 1 to release reset */
		reset-gpios = <&gpp25 2 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&amp_bottom_irq &amp_bottom_rst>;
		pinctrl-names = "default";
		VA-supply = <&amp_va>;
		VP-supply = <&amp_vp>;
		sound-name-prefix = "Bottom";
		cirrus,subsystem-id = "cheetah";
		cirrus,boost-type = <0>;
		cirrus,boost-peak-milliamp = <2500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <30>;
		cirrus,asp-sdout-hiz = <3>;
		/* the stock protection firmware does not survive hibernation */
		cirrus,dsp-no-hibernate;
		cirrus,gpio2-src-select = <5>;
		cirrus,gpio2-output-enable;
		status = "disabled";
	};
};

&pinctrl_far_alive {
	amp_top_irq: amp-top-irq-pins {
		samsung,pins = "gpa6-3";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	amp_bottom_irq: amp-bottom-irq-pins {
		samsung,pins = "gpa8-6";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric0 {
	amp_top_cs: amp-top-cs-pins {
		samsung,pins = "gpp14-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_5_MA>;
	};

	amp_top_rst: amp-top-rst-pins {
		samsung,pins = "gpp17-1";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric1 {
	amp_bottom_cs: amp-bottom-cs-pins {
		samsung,pins = "gpp22-1";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	amp_bottom_rst: amp-bottom-rst-pins {
		samsung,pins = "gpp25-2";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&usbdrd31_phy {
	status = "okay";
};

&usb_dwc3 {
	status = "okay";
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

/*
 * MAX77759 (charger, Type-C port controller, fuel gauge) on USI13. All of
 * its interrupt lines are on ALIVE gpa9, active low with pull-ups.
 *
 * The Type-C port controller stays disabled: the USB link is our only way
 * into the phone, and TCPM would take over VBUS and data role from the
 * forced-VBUS setup the USB PHY uses today. Its graph links to the USB PHY
 * (orientation, i.e. VBUS valid) and dwc3 (role switch) are added by the
 * bring-up overlays. The charger has no DT node of its own (it is an MFD
 * cell of pmic@66, which carries its monitored-battery); its probe turns
 * charging off until a "tcpm-source" power supply reports a source, unless
 * it is loaded with default_ilim_ua.
 */
&usi13 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_13 {
	clock-frequency = <400000>;
	status = "okay";

	usb-typec@25 {
		compatible = "maxim,max77759-tcpci", "maxim,max33359";
		reg = <0x25>;
		interrupts-extended = <&gpa9 7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&typec_int>;
		pinctrl-names = "default";
		status = "disabled";

		/*
		 * Sink only for now: sourcing VBUS goes through an external
		 * boost on this board (stock: max77759,ext-otg-only, switched
		 * by MAX77759 GPIO5 "bst-on" and the TCPC's EXTBST_CTRL), which
		 * has no driver yet, so there is no vbus-supply. MAX77759 GPIO6
		 * is the VBUS input switch (stock in-switch-gpio): leave it.
		 * Stock is dual role with try-sink and a 5 V / 900 mA source
		 * PDO. Sink PDOs as on gs101 and stock; PD stays off.
		 */
		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "sink";
			self-powered;
			op-sink-microwatt = <2600000>;
			sink-pdos = <PDO_FIXED(5000, 3000,
					       (PDO_FIXED_DATA_SWAP
						| PDO_FIXED_USB_COMM
						| PDO_FIXED_HIGHER_CAP
						| PDO_FIXED_DUAL_ROLE))
				     PDO_FIXED(9000, 2200, 0)
				     PDO_PPS_APDO(5000, 11000, 3000)>;
			pd-disable;
			typec-power-opmode = "default";
		};
	};

	fuel-gauge@36 {
		compatible = "maxim,max77759-fg";
		reg = <0x36>;
		interrupts-extended = <&gpa9 3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_fg_int>;
		pinctrl-names = "default";
		/* maxim,rsense-default = <500> (10 uOhm units) in Google's tree */
		shunt-resistor-micro-ohms = <5000>;
		monitored-battery = <&battery>;

		/*
		 * Battery model for the pack with a 1 kOhm ID resistor, the one
		 * this phone has (stock: "device battery RID: 1 kohm"). From
		 * Google's gs201-cheetah-battery-data.dtsi (cos-a1-1k, model
		 * version 1), except RelaxCfg 0x143b and FilterCfg 0xc613, the
		 * values stock writes over the model's at boot (r_regval_1720x,
		 * filtercfg-default). TaskPeriod 0x2d00 makes one capacity LSB
		 * 2 mAh with 5 mOhm: DesignCap 0x09c5 = 5002 mAh.
		 */
		maxim,fg-model = /bits/ 16 <
			0xa4e0 0xb750 0xb8a0 0xba60 0xbc10 0xbdd0 0xbf30 0xc070
			0xc1e0 0xc4b0 0xc7f0 0xcd80 0xd130 0xd4e0 0xd920 0xdca0
			0x0120 0x1240 0x0c00 0x12a0 0x1400 0x1700 0x1060 0x0fd0
			0x07e0 0x07f0 0x07c0 0x06d0 0x06c0 0x06f0 0x0640 0x0640
			0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200
			0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200
		>;
		maxim,fg-params = /bits/ 16 <
			0xf060	/* IAvgEmpty */
			0x143b	/* RelaxCfg */
			0x260e	/* LearnCfg */
			0x4217	/* Config: external thermistor, TEx clear */
			0x0090	/* Config2 */
			0x5f00	/* FullSOCThr */
			0x09c5	/* FullCapRep */
			0x09c5	/* DesignCap */
			0x3200	/* dPAcc */
			0x0271	/* dQAcc */
			0x09c5	/* FullCapNom */
			0xa561	/* VEmpty */
			0x2080	/* QRTable00 */
			0x0e80	/* QRTable10 */
			0x0580	/* QRTable20 */
			0x0480	/* QRTable30 */
			0x0770	/* RComp0 */
			0x2202	/* TempCo */
			0x0628	/* IChgTerm */
			0xed51	/* TGain */
			0x1eba	/* TOff */
			0x0014	/* Curve */
			0x3870	/* MiscCfg */
			0x1900	/* AtRate */
			0x2241	/* ConvgCfg */
			0xc613	/* FilterCfg */
			0x2d00	/* TaskPeriod */
		>;
	};

	pmic@66 {
		compatible = "maxim,max77759";
		reg = <0x66>;
		interrupts-extended = <&gpa9 4 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_int>;
		pinctrl-names = "default";
		interrupt-controller;
		#interrupt-cells = <2>;
		/* for the charger cell */
		monitored-battery = <&battery>;

		gpio {
			compatible = "maxim,max77759-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};

/*
 * Haptics: Cirrus Logic CS40L26A at 0x43 on PERIC0 USI8 (Google's I2C bus
 * 8), INTb on gpa8-1, RESET on gpp24-3. Boost and actuator values are the
 * stock ones (Google's gs201-cs40l26a-config.dtsi). Tested on the phone
 * (HAPTICS-TORCH-PLAN.md H1-H4). The bus pins are on PERIC0 (gpp16-0/1).
 */
&pinctrl_peric0 {
	status = "okay";
};

&usi8 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_8 {
	clock-frequency = <400000>;
	status = "okay";

	haptics: haptic-driver@43 {
		compatible = "cirrus,cs40l26a";
		reg = <0x43>;
		interrupts-extended = <&gpa8 1 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp24 3 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&hapt_amp_irq &hapt_amp_rst>;
		pinctrl-names = "default";
		cirrus,boost-peak-microamp = <2500000>;
		cirrus,boost-ctl-microvolt = <11000000>;
		cirrus,lra-f0-hz = <145>;
		cirrus,lra-redc-micro-ohms = <13000000>;
	};

	/*
	 * NFC: the NCI controller of the ST54J (NFC + eSE combo) at 0x08,
	 * IRQ on gpa9-1, reset on gph1-5 (HSI1). Stock: st21nfc@8. The eSE
	 * side (SPI, reset gph1-4) is left alone: no ese-present here.
	 * The reference clock is the PMU's CLKOUT1 pad, which stock enables
	 * while the device is open. Disabled until the nfc-test overlay.
	 */
	nfc@8 {
		compatible = "st,st54j-i2c", "st,st21nfcc-i2c";
		reg = <0x08>;
		clocks = <&pmu_system_controller 1>;	/* CLKOUT1 */
		interrupts-extended = <&gpa9 1 IRQ_TYPE_LEVEL_HIGH>;
		reset-gpios = <&gph1 5 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&nfc_rst>;
		pinctrl-names = "default";
		status = "disabled";
	};
};

/*
 * Rear flash LED: TI LM3644TT at 0x63 on PERIC1 USI15 (Google's I2C bus 15,
 * shared with the camera EEPROM), HWEN on gpp8-2. Stock drives it from the
 * camera HAL through LWIS. Torch only; the cap here is our own bring-up
 * limit, not a stock value. Tested on the phone (T1-T4).
 */
&usi15 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_15 {
	clock-frequency = <400000>;
	status = "okay";

	led-controller@63 {
		compatible = "ti,lm3644";
		reg = <0x63>;
		enable-gpios = <&gpp8 2 GPIO_ACTIVE_HIGH>;

		led {
			function = LED_FUNCTION_TORCH;
			color = <LED_COLOR_ID_WHITE>;
			led-sources = <1 2>;
			led-max-microamp = <50000>;
		};
	};
};

&pinctrl_far_alive {
	hapt_amp_irq: hapt-amp-irq-pins {
		samsung,pins = "gpa8-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_peric1 {
	hapt_amp_rst: hapt-amp-rst-pins {
		samsung,pins = "gpp24-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_gpio_alive {
	fp_irq: fp-irq-pins {
		samsung,pins = "gpa9-2";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	if_pmic_fg_int: if-pmic-fg-int-pins {
		samsung,pins = "gpa9-3";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	if_pmic_int: if-pmic-int-pins {
		samsung,pins = "gpa9-4";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	typec_int: typec-int-pins {
		samsung,pins = "gpa9-7";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

/*
 * Wi-Fi: BCM4389 on PCIe GEN4A_1, one lane at Gen2 as on stock. The chip's
 * DMA buffers come from wifi_dma_pool. The chip's 0.85 V and 1.8 V PCIe
 * rails (S2MPG13 LDO3 and LDO18) are always on.
 */
&pcie_1 {
	status = "okay";
	pinctrl-0 = <&pcie1_clkreq>, <&pcie1_perst>, <&wlan_dev_wake>,
		    <&wlan_host_wake>;
	pinctrl-names = "default";

	pcie@0,0 {
		compatible = "pciclass,0604";
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		bus-range = <0x01 0xff>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		vpcie3v3-supply = <&wlan_pwr>;

		wifi@0,0 {
			compatible = "pci14e4,4441";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			brcm,board-type = "google,gs201-cheetah";
			memory-region = <&wifi_dma_pool>;
		};
	};
};

/*
 * Bluetooth: the BCM4389 BT core on the APM USI1 UART (ttySAC18 in
 * Google's kernel). Tested on the phone (BLUETOOTH-PLAN.md BT1-BT3): the
 * UART clocks come from a read-only CMU_APM subset, and BT_REG_ON and
 * BT_DEV_WAKE are on PERIC0's gpp16. BT_REG_ON is separate from Wi-Fi's
 * WL_REG_ON (gph2-4), so Bluetooth powers up alone.
 */
&cmu_apm {
	status = "okay";
};

&usi_apm1 {
	status = "okay";
};

&serial_apm1 {
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4389-bt";
		shutdown-gpios = <&gpp16 2 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpp16 3 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpa6 6 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "host-wakeup";
		pinctrl-0 = <&bt_reg_on &bt_dev_wake &bt_host_wake>;
		pinctrl-names = "default";
		max-speed = <3000000>;
	};
};

&pinctrl_peric0 {
	status = "okay";

	bt_reg_on: bt-reg-on-pins {
		samsung,pins = "gpp16-2";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	bt_dev_wake: bt-dev-wake-pins {
		samsung,pins = "gpp16-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pcie_1_phy {
	status = "okay";
};

/*
 * The window for the PCIe System MMU. The node stays disabled: the PCIe and
 * UFS masters share its VID 0, so it cannot confine the Wi-Fi chip without
 * also confining storage.
 */
&pcie_1_sysmmu {
	google,dma-window = <&wifi_dma_pool>;
};

&pinctrl_far_alive {
	wlan_host_wake: wlan-host-wake-pins {
		samsung,pins = "gpa6-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	bt_host_wake: bt-host-wake-pins {
		samsung,pins = "gpa6-6";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_hsi2 {
	status = "okay";

	wlan_reg_on: wlan-reg-on-pins {
		samsung,pins = "gph2-4";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_NONE>;
	};

	wlan_dev_wake: wlan-dev-wake-pins {
		samsung,pins = "gph2-5";
		samsung,pin-function = <GS101_PIN_FUNC_INPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_DOWN>;
	};
};

/*
 * GNSS: Broadcom BCM4775x on PERIC0 USI5 SPI (Google's spi5), 26 MHz, mode 3,
 * as on stock (spi5 node and bcm4775@0 in the stock device tree). Chip
 * select is driven as a GPIO, like the touchscreen's. The stock lhd/gpsd
 * daemons drive it through /dev/ttyBCM. Disabled until the gnss-test
 * overlay (GNSS-PLAN.md, G2).
 */
&usi5 {
	samsung,mode = <USI_MODE_SPI>;
};

&spi_5 {
	pinctrl-0 = <&spi5_bus &spi5_cs_gpio>;
	cs-gpios = <&gpp10 3 GPIO_ACTIVE_LOW>;
	num-cs = <1>;

	gnss@0 {
		compatible = "brcm,bcm4775-gnss";
		reg = <0>;
		spi-max-frequency = <26000000>;
		spi-cpol;
		spi-cpha;
		interrupts-extended = <&gpa6 4 IRQ_TYPE_LEVEL_HIGH>;
		/* Raw levels: lhd writes 1 to the nstandby attribute to run it */
		nstandby-gpios = <&gph2 3 GPIO_ACTIVE_HIGH>;
		mcu-req-gpios = <&gpp4 3 GPIO_ACTIVE_HIGH>;
		mcu-resp-gpios = <&gph2 2 GPIO_ACTIVE_HIGH>;
		host-req-gpios = <&gpa6 4 GPIO_ACTIVE_HIGH>;
		vddcore-supply = <&ldo9s>;
		vddrf-supply = <&ldo10s>;
		vddaux-supply = <&ldo11s>;
		pinctrl-0 = <&gnss_nstandby &gnss_mcu_resp &gnss_mcu_req
			     &gnss_host_req>;
		pinctrl-names = "default";
	};
};

&pinctrl_hsi2 {
	gnss_mcu_resp: gnss-mcu-resp-pins {
		samsung,pins = "gph2-2";
		samsung,pin-function = <GS101_PIN_FUNC_INPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_DOWN>;
	};

	gnss_nstandby: gnss-nstandby-pins {
		samsung,pins = "gph2-3";
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric0 {
	gnss_mcu_req: gnss-mcu-req-pins {
		samsung,pins = "gpp4-3";
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_far_alive {
	gnss_host_req: gnss-host-req-pins {
		samsung,pins = "gpa6-4";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_hsi1 {
	/* As stock: only the power-down state; the driver owns the level. */
	nfc_rst: nfc-rst-pins {
		samsung,pins = "gph1-5";
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_NONE>;
	};
};

/*
 * Modem: Samsung S5300 on PCIe GEN4A_0 (HSI1), with its control lines from
 * the stock cpif node and its shared memory from stock's cp_shmem node (IPC,
 * MSI page, packet buffers). Raw levels, as Google's CPIF drives them. The
 * link driver (pcie-gs201-cp) drives the lines while this node is enabled;
 * the modem driver (CPIF) takes them, and the memory, from this node when
 * an overlay disables it for the link driver (MODEM-PLAN.md M3). Disabled
 * until the modem-link-test or modem-cpif-test overlay, which also enable
 * the HSI1 pin controller.
 */
&pcie_0 {
	modem {
		compatible = "samsung,s5300-modem";
		memory-region = <&{/reserved-memory/cp-rmem@ea400000}>,
				<&cp_msi_mem>,
				<&{/reserved-memory/cp-rmem1@e8000000}>;
		ap2cp-pda-active-gpios = <&gph1 1 GPIO_ACTIVE_HIGH>;
		ap2cp-cp-pwr-on-gpios = <&gph1 2 GPIO_ACTIVE_HIGH>;
		ap2cp-nreset-gpios = <&gph1 3 GPIO_ACTIVE_HIGH>;
		ap2cp-cp-wrst-gpios = <&gph1 6 GPIO_ACTIVE_HIGH>;
		ap2cp-pm-wrst-gpios = <&gpa0 3 GPIO_ACTIVE_HIGH>;
		ap2cp-wakeup-gpios = <&gph0 2 GPIO_ACTIVE_HIGH>;
		ap2cp-dump-noti-gpios = <&gph0 3 GPIO_ACTIVE_HIGH>;
		cp2ap-cp-wrst-gpios = <&gpa0 2 GPIO_ACTIVE_HIGH>;
		cp2ap-ps-hold-gpios = <&gpa8 2 GPIO_ACTIVE_HIGH>;
		cp2ap-wakeup-gpios = <&gpa8 3 GPIO_ACTIVE_HIGH>;
		cp2ap-phone-active-gpios = <&gpa8 4 GPIO_ACTIVE_HIGH>;
	};
};

&pinctrl_peric0 {
	fp_reset: fp-reset-pins {
		samsung,pins = "gpp1-1";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

/*
 * Camera power (CAMERA-PLAN.md 1.2), from Google's GPL pantah camera PMIC
 * device tree: two fixed supplies switched by S2MPG13 GPIOs feed the
 * SLG51002 camera PMIC on I2C bus 8, which with LDO12S powers the modules.
 * Voltages are stock's. All disabled until the camera-pwr-test overlay; the
 * new drivers are blacklisted from autoload as well.
 */
/ {
	pp3200_bb_cam: regulator-pp3200-bb-cam {
		compatible = "regulator-fixed";
		regulator-name = "PP3200_BB_CAM";
		regulator-min-microvolt = <3200000>;
		regulator-max-microvolt = <3200000>;
		regulator-enable-ramp-delay = <2000>;
		gpio = <&pmic_2_gpio 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		status = "disabled";
	};

	pp1300_cam: regulator-pp1300-cam {
		compatible = "regulator-fixed";
		regulator-name = "PP1300_CAM";
		regulator-min-microvolt = <1300000>;
		regulator-max-microvolt = <1300000>;
		regulator-enable-ramp-delay = <2000>;
		gpio = <&pmic_2_gpio 3 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		status = "disabled";
	};
};

&hsi2c_8 {
	cam_pmic: pmic@75 {
		compatible = "dlg,slg51002";
		reg = <0x75>;
		dlg,cs-gpios = <&pmic_2_gpio 0 GPIO_ACTIVE_HIGH>;
		vin1-2-supply = <&pp3200_bb_cam>;
		vin3-supply = <&pp3200_bb_cam>;
		vin4-supply = <&pp3200_bb_cam>;
		vin5-supply = <&pp3200_bb_cam>;
		vin6-supply = <&pp1300_cam>;
		vin7-supply = <&pp1300_cam>;
		vin8-supply = <&pp1300_cam>;
		status = "disabled";

		regulators {
			cam_ldo1: ldo1 {
				regulator-name = "vdda_main";
				regulator-min-microvolt = <2850000>;
				regulator-max-microvolt = <2850000>;
			};

			cam_ldo2: ldo2 {
				regulator-name = "vdda_uw";
				regulator-min-microvolt = <2850000>;
				regulator-max-microvolt = <2850000>;
			};

			cam_ldo3: ldo3 {
				regulator-name = "vdda_tele";
				regulator-min-microvolt = <2250000>;
				regulator-max-microvolt = <2250000>;
			};

			cam_ldo4: ldo4 {
				regulator-name = "vdd_main_af";
				regulator-min-microvolt = <2900000>;
				regulator-max-microvolt = <2900000>;
			};

			cam_ldo5: ldo5 {
				regulator-name = "vdd_tele_module";
				regulator-min-microvolt = <2850000>;
				regulator-max-microvolt = <2850000>;
			};

			cam_ldo6: ldo6 {
				regulator-name = "vddd_uw";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
			};

			cam_ldo7: ldo7 {
				regulator-name = "vddd_tele";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
			};

			cam_ldo8: ldo8 {
				regulator-name = "vddd_main_front";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
			};

			cam_sw1: sw1 {
				regulator-name = "cam_sw1";
			};

			cam_sw2: sw2 {
				regulator-name = "cam_sw2";
			};

			cam_sw3: sw3 {
				regulator-name = "cam_sw3";
			};

			cam_sw4: sw4 {
				regulator-name = "cam_sw4";
			};
		};
	};
};

/*
 * Ultrawide camera module on PERIC0 USI3 (Google's I2C bus 3): sensor at
 * 0x1a (16-bit addresses, 8-bit values), module EEPROM at 0x50, AF actuator
 * at 0x0f. Bring-up only (CAMERA-PLAN.md CAM2/CAM3): gs201-cam-power powers
 * the sensor in stock's order (PP3200_BB, PP1300, LDO12S, LDO6, LDO2, 1 ms,
 * MCLK on, 1 ms, reset released, 10 ms) and reads its identification
 * registers; the EEPROM needs LDO12S only and is only checked for an
 * answer. MCLK is CIS_CLK0 on gpp3-0 at whatever rate the bootloader set
 * (stock asks for 24 MHz). Disabled until camera-pwr-test.
 */
&usi3 {
	samsung,mode = <USI_MODE_I2C>;
};

&hsi2c_3 {
	clock-frequency = <950000>;

	camera@1a {
		compatible = "google,gs201-camera-power-test";
		reg = <0x1a>;
		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK0>;
		pinctrl-names = "on", "off";
		pinctrl-0 = <&cam_uw_mclk_on>;
		pinctrl-1 = <&cam_uw_mclk_off>;
		reset-gpios = <&gpp6 3 GPIO_ACTIVE_LOW>;
		google,supply-names = "pp3200", "pp1300", "dovdd", "dvdd", "avdd";
		pp3200-supply = <&pp3200_bb_cam>;
		pp1300-supply = <&pp1300_cam>;
		dovdd-supply = <&ldo12s>;
		dvdd-supply = <&cam_ldo6>;
		avdd-supply = <&cam_ldo2>;
		google,supply-on-delays-us = <0 0 0 0 1000>;
		google,supply-off-delays-us = <0 0 1000 0 0>;
		google,mclk-delay-us = <1000>;
		google,reset-delay-us = <10000>;
		/* Sony model ID, then the CCS identification block */
		google,readable-registers = <0x0016 0x0017 0x0000 0x0001 0x0002
					     0x0003 0x0004 0x0005>;
		status = "disabled";
	};

	eeprom@50 {
		compatible = "google,gs201-camera-power-test";
		reg = <0x50>;
		google,supply-names = "dovdd";
		dovdd-supply = <&ldo12s>;
		google,supply-on-delays-us = <1000>;
		google,supply-off-delays-us = <1000>;
		status = "disabled";
	};
};

&pinctrl_peric0 {
	cam_uw_mclk_on: cam-uw-mclk-on-pins {
		samsung,pins = "gpp3-0";
		samsung,pin-function = <GS101_PIN_FUNC_2>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	cam_uw_mclk_off: cam-uw-mclk-off-pins {
		samsung,pins = "gpp3-0";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

/*
 * Ultrawide capture (CAMERA-PLAN.md CAM3b/CAM4): the Sony IMX386 [HAL model
 * ID 0x0386] on four D-PHY lanes at 1548 Mbps per lane, through CSIS link 2
 * (DC-PHY slaves 2 and 3 as one four-lane receiver) and CSIS WDMA context 0
 * to memory. With the sensor streaming, links 0 and 1 see nothing; link 2 is
 * where its data arrives. All disabled; the camera-stream-link2 overlay
 * enables the path and the drivers are blacklisted as well. The MCLK runs
 * from the 24.576 MHz oscillator, as the stock sensor settings expect.
 */
&hsi2c_3 {
	camera-sensor@1a {
		compatible = "sony,imx386";
		reg = <0x1a>;
		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK0>;
		assigned-clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK0>;
		assigned-clock-rates = <24576000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_uw_mclk_on>;
		reset-gpios = <&gpp6 3 GPIO_ACTIVE_LOW>;
		/* stock's order: PP3200_BB, PP1300, LDO12S, LDO6, LDO2 */
		vbb-supply = <&pp3200_bb_cam>;
		vbuck-supply = <&pp1300_cam>;
		vif-supply = <&ldo12s>;
		vdig-supply = <&cam_ldo6>;
		vana-supply = <&cam_ldo2>;
		firmware-name = "omamobile/camera/imx386-uw.bin";
		/* 360 still let an odd frame of the 4032x3016 mode drop lines */
		sony,max-line-throughput = <330>;
		orientation = <1>;	/* back */
		rotation = <270>;	/* mounted the other way from the main camera (upside down at 90) */
		status = "disabled";

		port {
			uw_out: endpoint {
				remote-endpoint = <&csis2_in>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <774144000>;
			};
		};
	};
};

&csis2 {
	memory-region = <&camera_pool>;
};

&csis2_in {
	remote-endpoint = <&uw_out>;
	data-lanes = <1 2 3 4>;
};

&csis_dcphy {
	/* receive settings, generated from the phone's own camera software */
	firmware-name = "omamobile/camera/gs201-dcphy.bin";
};

/*
 * Ultrawide focus (CAMERA-PLAN.md CAM5.3): an AKM AK7375-type VCM driver at
 * 0x0f on the ultrawide's bus (stock "act-slenderman-sandworm"), on LDO12S
 * and the camera PMIC's LDO4 (2.9 V). Disabled; the camera-uw-lens overlay
 * enables it and links it to the sensor (lens-focus), and the ak7375
 * module must then load with the others or the media graph waits for it.
 */
&hsi2c_3 {
	uw_vcm: lens@f {
		compatible = "asahi-kasei,ak7375";
		reg = <0x0f>;
		vdd-supply = <&cam_ldo4>;
		vio-supply = <&ldo12s>;
		status = "disabled";
	};
};

/*
 * Main camera (CAMERA-PLAN.md CAM-M): the Samsung S5KGN1 [chip ID 0x08e1]
 * at 0x3d on PERIC0 USI1 (Google's I2C bus 1, 1 MHz as stock), three C-PHY
 * trios to CSIS link 1, then CSIS WDMA context 0 as the ultrawide. Its AF
 * VCM driver is an AK7375-type at 0x0c; the module's OIS/EEPROM controller
 * (0x24) and the laser AF (0x29) on the same bus are not described. Stock
 * power-up: PP3200_BB, PP1300, LDO12S, LDO4, 1 ms, SLG switch 3, LDO8,
 * LDO1, 2 ms, reset released, 1 ms, MCLK on (CIS_CLK3 on gpp9-0), 9 ms.
 * The sensor settings expect a 24.576 MHz clock (their EXCK register).
 * All disabled; the camera-main overlay enables them, and the drivers are
 * blacklisted as well.
 */
&usi1 {
	samsung,mode = <USI_MODE_I2C>;
};

&hsi2c_1 {
	clock-frequency = <1000000>;

	main_vcm: lens@c {
		compatible = "asahi-kasei,ak7375";
		reg = <0x0c>;
		vdd-supply = <&cam_ldo4>;
		vio-supply = <&ldo12s>;
		status = "disabled";
	};

	camera-sensor@3d {
		compatible = "samsung,s5kgn1";
		reg = <0x3d>;
		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK3>;
		assigned-clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK3>;
		assigned-clock-rates = <24576000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_main_mclk_on>;
		reset-gpios = <&gpp2 2 GPIO_ACTIVE_LOW>;
		vbb-supply = <&pp3200_bb_cam>;
		vbuck-supply = <&pp1300_cam>;
		vio-supply = <&ldo12s>;
		vaux-supply = <&cam_ldo4>;
		vsw-supply = <&cam_sw3>;
		vdig-supply = <&cam_ldo8>;
		vana-supply = <&cam_ldo1>;
		firmware-name = "omamobile/camera/s5kgn1-main.bin";
		/* the CSIS WDMA drops lines arriving above ~400 MB/s */
		samsung,max-line-throughput = <360>;
		orientation = <1>;	/* back */
		rotation = <90>;	/* upright in Snapshot with the phone in portrait */
		status = "disabled";

		port {
			main_out: endpoint {
				remote-endpoint = <&csis1_in>;
				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
				data-lanes = <1 2 3>;
				/* half the trio symbol rate [I], from the data file */
				link-frequencies = /bits/ 64 <931229968>;
			};
		};
	};
};

&pinctrl_peric0 {
	cam_main_mclk_on: cam-main-mclk-on-pins {
		samsung,pins = "gpp9-0";
		samsung,pin-function = <GS101_PIN_FUNC_2>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&csis1 {
	memory-region = <&camera_pool>;
};

&csis1_in {
	remote-endpoint = <&main_out>;
	bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
	data-lanes = <1 2 3>;
};

/*
 * Front camera (CAMERA-PLAN.md CAM7): the Samsung S5K3J1 [chip ID 0x30a1]
 * at 0x10 on PERIC0 USI2 (Google's I2C bus 2, 950 kHz as stock), four
 * D-PHY lanes to CSIS link 0, then CSIS WDMA context 0 as the others. Fixed
 * focus; the module EEPROM at 0x51 is not described. Stock power-up:
 * PP3200_BB, PP1300, LDO12S, LDO8, SLG switch 4, 1 ms, MCLK on (CIS_CLK1
 * on gpp5-0), 1 ms, reset released (gpp4-2), 8 ms. Its settings expect the
 * 24.576 MHz oscillator as the other cameras' do. All disabled; the
 * camera-front overlay enables them, and the drivers are blacklisted.
 */
&usi2 {
	samsung,mode = <USI_MODE_I2C>;
};

&hsi2c_2 {
	clock-frequency = <950000>;

	camera-sensor@10 {
		compatible = "samsung,s5k3j1";
		reg = <0x10>;
		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK1>;
		assigned-clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK1>;
		assigned-clock-rates = <24576000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_front_mclk_on>;
		reset-gpios = <&gpp4 2 GPIO_ACTIVE_LOW>;
		vbb-supply = <&pp3200_bb_cam>;
		vbuck-supply = <&pp1300_cam>;
		vio-supply = <&ldo12s>;
		vdig-supply = <&cam_ldo8>;
		vsw-supply = <&cam_sw4>;
		firmware-name = "omamobile/camera/s5k3j1-front.bin";
		samsung,max-line-throughput = <360>;
		orientation = <0>;	/* front */
		rotation = <90>;	/* upside down at 270 in Snapshot */
		status = "disabled";

		port {
			front_out: endpoint {
				remote-endpoint = <&csis0_in>;
				data-lanes = <1 2 3 4>;
				/* 1665 Mbps per lane, from the data file [I] */
				link-frequencies = /bits/ 64 <832512000>;
			};
		};
	};
};

&csis0 {
	memory-region = <&camera_pool>;
};

&csis0_in {
	remote-endpoint = <&front_out>;
	data-lanes = <1 2 3 4>;
};

/*
 * Telephoto (CAMERA-PLAN.md CAM-T): the Samsung S5KGM5 [chip ID 0x08d5] at
 * 0x2d on PERIC0 USI4 (Google's I2C bus 4, 1 MHz as stock), two C-PHY
 * trios to CSIS link 4 / DC-PHY slave 4, which also needs to expect its
 * LRTE packet delimiters [I]. The folded optics mirror the image, which
 * the sensor undoes with a vertical readout flip [I]. Stock power-up:
 * PP3200_BB, PP1300, LDO12S, 0.3 ms, LDO7, LDO3, MCLK on (CIS_CLK2 on
 * gpp7-0), 1 ms, reset released (gpp6-2), 10 ms. Its SEM1215SA at 0x34
 * drives focus and OIS and holds the module's calibration; stock powers
 * it from LDO12S, 1 ms, SLG LDO5 2.85 V and switch 1. gpp8-2 (the torch's
 * HWEN) shares the bank with this bus's pins. All disabled; the
 * camera-tele overlay enables them, and the drivers are blacklisted.
 */
&usi4 {
	samsung,mode = <USI_MODE_I2C>;
};

&hsi2c_4 {
	/*
	 * Below 1 MHz: i2c-exynos5 runs 1 MHz as high-speed mode (master
	 * code first), which stock's driver doesn't without samsung,hs-mode;
	 * the telephoto's SEM1215SA lens hung the bus in it.
	 */
	clock-frequency = <950000>;

	camera-sensor@2d {
		compatible = "samsung,s5kgm5";
		reg = <0x2d>;
		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK2>;
		assigned-clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK2>;
		assigned-clock-rates = <24576000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_tele_mclk_on>;
		reset-gpios = <&gpp6 2 GPIO_ACTIVE_LOW>;
		vbb-supply = <&pp3200_bb_cam>;
		vbuck-supply = <&pp1300_cam>;
		vio-supply = <&ldo12s>;
		vdig-supply = <&cam_ldo7>;
		vana-supply = <&cam_ldo3>;
		firmware-name = "omamobile/camera/s5kgm5-tele.bin";
		samsung,max-line-throughput = <360>;
		samsung,vertical-flip;
		orientation = <1>;	/* back */
		rotation = <270>;	/* with the vertical flip: upside down at 90 in Snapshot */
		status = "disabled";

		port {
			tele_out: endpoint {
				remote-endpoint = <&csis4_in>;
				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
				data-lanes = <1 2>;
				/* half the trio symbol rate per mode, from the data file [I] */
				link-frequencies = /bits/ 64 <901120000 1019904000>;
			};
		};
	};

	tele_lens: lens@34 {
		compatible = "semco,sem1215sa";
		reg = <0x34>;
		vbb-supply = <&pp3200_bb_cam>;
		vio-supply = <&ldo12s>;
		vdd-supply = <&cam_ldo5>;
		vsw-supply = <&cam_sw1>;
		status = "disabled";
	};
};

&csis4 {
	memory-region = <&camera_pool>;
	google,lrte-packet-delimiters;
};

&csis4_in {
	remote-endpoint = <&tele_out>;
	bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
	data-lanes = <1 2>;
};

&pinctrl_peric0 {
	cam_front_mclk_on: cam-front-mclk-on-pins {
		samsung,pins = "gpp5-0";
		samsung,pin-function = <GS101_PIN_FUNC_2>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	cam_tele_mclk_on: cam-tele-mclk-on-pins {
		samsung,pins = "gpp7-0";
		samsung,pin-function = <GS101_PIN_FUNC_2>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};
