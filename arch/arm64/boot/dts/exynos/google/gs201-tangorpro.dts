// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel Tablet (tangorpro) - first-light board file.
 *
 * USB (NCM + ACM), the cluster watchdogs from gs201.dtsi and a
 * simple-framebuffer on the buffer the bootloader leaves the panel
 * scanning out. The panel driver, backlight, touch, the GPU and UFS stay
 * disabled. The tablet has no modem.
 */

/dts-v1/;

#include "gs201.dtsi"

/ {
	model = "Google Pixel Tablet";
	compatible = "google,gs201-tangorpro", "google,gs201";

	/*
	 * ABL's base-DTB match: product id 0x09855000 | major revision (B0 is
	 * 1), as on the other gs201 Pixels.
	 */
	soc_id = <0x09855001 0x0>;

	chosen {
		/* ABL requires bootargs to exist; it appends its own after these. */
		bootargs = "console=tty0 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * ABL hands the display over at 0xfac00000 (the 20 MiB
		 * fb_handover region in Google's tangorpro display tree). The
		 * LCD runs in DSI video mode, so DECON keeps scanning the
		 * buffer with no trigger. There is no panel driver, so no panel
		 * phandle; the size comes from this node: 1600 x 2560
		 * portrait, ARGB8888 assumed as on panther until DPP0's
		 * registers are read on this tablet.
		 */
		framebuffer0: framebuffer@fac00000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfac00000 (1600 * 2560 * 4)>;
			memory-region = <&cont_splash_mem>;
			width = <1600>;
			height = <2560>;
			stride = <(1600 * 4)>;
			format = "a8r8g8b8";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * Stock's region and layout (ramoops_mem@fd3ff000 in Google's
		 * gs201-rmem.dtsi, which tangorpro does not override), so a log
		 * from this kernel can be read after a warm reboot into slot A.
		 */
		ramoops@fd3ff000 {
			compatible = "ramoops";
			reg = <0x0 0xfd3ff000 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		/* The whole handover region, as stock reserves it. */
		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 0x1400000>;
			no-map;
		};
	};
};

&usbdrd31_phy {
	status = "okay";
};

&usb_dwc3 {
	status = "okay";
};
