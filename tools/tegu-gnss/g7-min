#!/bin/bash
# A short GNSS session: engine start, 35 s of frames, then the location request
# stops, so Kepler's watchdog resets (and the CP link cycling) don't pile up.
set -uo pipefail
O=/var/log/omamobile/g7min; rm -rf "$O"; mkdir -p "$O"
say() { printf 'g7min: %s\n' "$*"; }
for n in gnss-core gnss-rf gnss-aux; do
  r=$(grep -lx "$n" /sys/class/regulator/*/name 2>/dev/null | head -1)
  [[ -n $r && $(cat "$(dirname "$r")/state") == enabled ]] || { say "STOP: $n"; exit 1; }
done
/usr/local/bin/omamobile-tegu-modem-up --gnss || { say "STOP: modem not ONLINE"; exit 1; }
for _ in $(seq 1 120); do pgrep -x gnssd >/dev/null && break; sleep 0.25; done
pgrep -x gnssd >/dev/null || { say "STOP: no gnssd"; exit 1; }
dmesg -C
sleep 5
systemd-run -q --unit=x-gnss-slsi -p KillMode=control-group sh -c \
  "OMAMOBILE_GNSS_NMEA_OUT=stdout /usr/lib/omamobile-vendor/omamobile-vendor-chroot gnss-slsi start > $O/gnss-slsi.log 2>&1"
sleep 35
systemctl stop x-gnss-slsi 2>/dev/null
dmesg | grep -a "gnss_spi: " > "$O/rx.txt"
tail -n 400 /var/log/omamobile/modem.log > "$O/modem.log"
say "done: $(wc -l < "$O/rx.txt") dump lines"
